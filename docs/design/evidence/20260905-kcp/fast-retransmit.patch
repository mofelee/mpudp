+// SetFastRetransmit enables or disables both fast and early retransmissions.
+// Enabled is the default. Disabling preserves initial sends, ACK processing,
+// RTO retransmissions and congestion control. NoDelay does not change this policy.
+// Changing the policy discards accumulated gap evidence. As with other KCP
+// methods, callers must synchronize access to the state machine.
+func (kcp *KCP) SetFastRetransmit(enabled bool) {
+	if kcp.fastRetransmitDisabled == !enabled {
+		return
+	}
+	kcp.fastRetransmitDisabled = !enabled
+	for seg := range kcp.snd_buf.ForEach {
+		seg.fastack = 0
+	}
+}
