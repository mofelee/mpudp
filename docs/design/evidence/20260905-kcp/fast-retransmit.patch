+// SetFastRetransmit enables or disables both fast and early retransmissions.
+// Enabled is the default. RTO retransmissions remain active when disabled.
+// SetNoDelay does not change this policy.
+func (s *UDPSession) SetFastRetransmit(enabled bool) {
+	s.mu.Lock()
+	s.kcp.SetFastRetransmit(enabled)
+	s.mu.Unlock()
+}
