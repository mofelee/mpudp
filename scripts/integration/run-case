			mpudp-forward "${failure_forward_before[$((path - 1))]}"
	done
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "one or more PMTU UDP observers exited unexpectedly"; return 1; }
	stop_fragment_observers || { mpudp_it_die "one or more PMTU fragment observers exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_udp_lengths_at_most "${failure_budget}"
	assert_udp_length_absent_direction "${failure_budget}" forward 1
	assert_udp_length_paths_direction "${failure_budget}" forward 2 3 4 5
	assert_no_wire_fragments
	grep -q "\"event\":\"datagram_partially_sent\",\"phase\":\"main\",\"bytes\":${failure_bytes}.*\"error_kinds\":\[\"partial_send\",\"path_mtu_exceeded\"\]" \
		"${peer_initiator_events}" || { mpudp_it_die "PMTU partial-send classification metadata is missing"; return 1; }
	grep -q "\"event\":\"datagram_received\",\"phase\":\"main\",\"bytes\":${failure_bytes}" \
		"${peer_listener_events}" || { mpudp_it_die "Bob did not recover the PMTU Datagram from surviving paths"; return 1; }

	restore_peer_payload_mtu
	trap - RETURN
	mpudp_it_log "case passed: ${case_name} (exact/+1 budget, bidirectional sizing, PMTU partial send, zero fragments)"
}

