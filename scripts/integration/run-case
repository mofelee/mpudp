run_canonical_mtu_safe_phase() {
	local family=$1 flow=$2 path_mtu=$3 listener_budget=$4 initiator_budget=$5
	local exact_bytes=$6 wire_budget=$7 oversize_bytes path table nft_family
	local -a fragment_pids=() fragment_event_files=() fragment_log_files=()
	local -a udp_pids=() udp_event_files=() udp_log_files=() udp_event_counts=()
	local -a path_counter_snapshot=() forward_before=() reverse_before=()
	oversize_bytes=$((exact_bytes + 1))
	table=${MPUDP_IT_TABLE4}
	nft_family=ip
	if [[ ${family} == 6 ]]; then
		table=${MPUDP_IT_TABLE6}
		nft_family=ip6
	fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu \
		--path 1 --family "${family}" --value "${path_mtu}"
	start_fragment_observers "${family}" "${flow}"
	start_udp_observers "${family}" both "${flow}"
	start_peer_exchange "${family}" "${flow}" "${listener_budget}" "${initiator_budget}" \
		"${exact_bytes}" "${exact_bytes}" "${oversize_bytes}" false false
	assert_five_carrier_sockets "${family}" "${flow}"
	# The probe is blocked before either tested WritePacket, so this snapshot
	# distinguishes local exact-limit+1 rejection from any emitted shard.
	sleep 0.2
	snapshot_udp_event_counts
	snapshot_path_counters "${family}" mpudp-forward
	forward_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters "${family}" mpudp-reverse
	reverse_before=("${path_counter_snapshot[@]}")
	release_peer_oversize
	sleep 0.1
	assert_udp_event_counts_unchanged
	for path in 1 2 3 4 5; do
		assert_counter_equal "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-forward "${forward_before[$((path - 1))]}"
		assert_counter_equal "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-reverse "${reverse_before[$((path - 1))]}"
	done
	release_peer_exchange
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "${flow} UDP observer exited unexpectedly"; return 1; }
	stop_fragment_observers || { mpudp_it_die "${flow} fragment observer exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_udp_lengths_at_most "${wire_budget}"
	assert_udp_length_all_paths_direction "${wire_budget}" forward
	assert_udp_length_all_paths_direction "${wire_budget}" reverse
	assert_no_wire_fragments
	assert_event_count "${peer_listener_events}" datagram_received main "${exact_bytes}" 1 \
		"${flow} exact-limit forward delivery"
	assert_event_count "${peer_initiator_events}" datagram_received main "${exact_bytes}" 1 \
		"${flow} exact-limit reverse delivery"
	if ! grep -q "\"event\":\"oversize_rejected\",\"phase\":\"oversize\",\"bytes\":${oversize_bytes}.*\"error_kinds\":\\[\"message_too_large\"\\]" \
		"${peer_initiator_events}"; then
		mpudp_it_die "${flow} exact-limit+1 rejection metadata is missing"
		return 1
	fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu \
		--path 1 --family "${family}" --value 1500
}

run_mtu_budget_no_fragment() {
	local _manifest_family=$1 path
	local -a fragment_pids=() fragment_event_files=() fragment_log_files=()
	local -a udp_pids=() udp_event_files=() udp_log_files=()
	local -a path_counter_snapshot=() failure_forward_before=()
	mpudp_it_require_commands tcpdump grep
	canonical_mtu_mutation_file=${MPUDP_IT_STATE_DIR}/mtu-budget-no-fragment.mutations
	: >"${canonical_mtu_mutation_file}"
	trap cleanup_canonical_mtu RETURN

	# The first exchange freezes min(1200,1000) in both directions.
	run_canonical_mtu_safe_phase 4 mtu-negotiate 1500 1000 1200 2787 1000
	# The second runs at IPv6's minimum link MTU with the default safe budget.
	run_canonical_mtu_safe_phase 6 mtu-ipv6-minimum 1280 1200 1200 3387 1200
	# The third proves an explicitly lowered global tunnel budget over IPv4.
	run_canonical_mtu_safe_phase 4 mtu-small-tunnel 576 520 1200 1347 520

	# Finally, deliberately overstate path 1's budget. Linux DF/PMTU must
	# reject its full-size shard while the remaining paths recover the block.
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu --path 1 --family 4 --value 576
	start_fragment_observers 4 mtu-pmtu-failure
	start_udp_observers 4 both mtu-pmtu-failure
	start_peer_exchange 4 mtu-pmtu-failure 1200 1200 3387 257 0 true false
	snapshot_path_counters 4 mpudp-forward
	failure_forward_before=("${path_counter_snapshot[@]}")
	release_peer_exchange
	assert_counter_equal "$(mpudp_it_ns t1)" ip "${MPUDP_IT_TABLE4}" \
		mpudp-forward "${failure_forward_before[0]}"
	for path in 2 3 4 5; do
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" ip "${MPUDP_IT_TABLE4}" \
			mpudp-forward "${failure_forward_before[$((path - 1))]}"
	done
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "PMTU failure UDP observer exited unexpectedly"; return 1; }
	stop_fragment_observers || { mpudp_it_die "PMTU failure fragment observer exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_udp_lengths_at_most 1200
	assert_udp_length_absent_direction 1200 forward 1
	assert_udp_length_paths_direction 1200 forward 2 3 4 5
	assert_no_wire_fragments
	if ! grep -q '"event":"datagram_partially_sent","phase":"main","bytes":3387.*"error_kinds":\["partial_send","path_mtu_exceeded"\]' \
		"${peer_initiator_events}"; then
		mpudp_it_die "PMTU failure did not expose partial_send plus path_mtu_exceeded"
		return 1
	fi
	assert_event_count "${peer_listener_events}" datagram_received main 3387 1 \
		"PMTU surviving-path recovery"

	cleanup_canonical_mtu
	trap - RETURN
	mpudp_it_log "case passed: ${case_name} (1200/1000 negotiation, IPv6 1280, 520 tunnel budget, exact/+1, PMTU, zero fragments)"
}

