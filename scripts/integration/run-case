run_peer_endpoint_expiry() {
	local family=$1 alice_ns bob_ns listen_address targets ready_file done_file
	local listener_status initiator_status wait_started expired elapsed accepted_count
	local -a listener_arguments initiator_arguments
	build_peerprobe
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	listen_address=0.0.0.0:9000
	if [[ ${family} == 6 ]]; then listen_address='[::]:9000'; fi
	targets=$(mpudp_it_join_targets "${family}")
	peer_listener_events=${MPUDP_IT_STATE_DIR}/${case_name}-bob.ndjson
	peer_initiator_events=${MPUDP_IT_STATE_DIR}/${case_name}-alice.ndjson
	peer_listener_log=${MPUDP_IT_STATE_DIR}/${case_name}-bob.log
	peer_initiator_log=${MPUDP_IT_STATE_DIR}/${case_name}-alice.log
	ready_file=${MPUDP_IT_STATE_DIR}/${case_name}.ready
	done_file=${MPUDP_IT_STATE_DIR}/${case_name}.done
	rm -f -- "${ready_file}" "${done_file}"
	: >"${peer_listener_log}"
	: >"${peer_initiator_log}"
	listener_arguments=(
		--role listener --flow expiry --family "${family}" --listen "${listen_address}"
		--max-udp-payload 1200 --endpoint-ttl 5s --keepalive 30s --expiry-wait 6s
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${peer_listener_events}"
		--ready-file "${ready_file}" --done-file "${done_file}"
	)
	initiator_arguments=(
		--role initiator --flow expiry --family "${family}" --carriers "${targets}"
		--max-udp-payload 1200 --endpoint-ttl 5s --keepalive 30s --expiry-wait 6s
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${peer_initiator_events}"
		--continue-file "${done_file}"
	)
	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${bob_ns}" "${peerprobe}" "${listener_arguments[@]}" >"${peer_listener_log}" 2>&1 &
	peer_listener_pid=$!
	mpudp_it_record_pid "${peer_listener_pid}"
	if ! wait_ready "${ready_file}" "${peer_listener_pid}"; then
		mpudp_it_die "Bob expiry Peer did not become ready; see ${peer_listener_log}"
		return 1
	fi
	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${alice_ns}" "${peerprobe}" "${initiator_arguments[@]}" >"${peer_initiator_log}" 2>&1 &
	peer_initiator_pid=$!
	mpudp_it_record_pid "${peer_initiator_pid}"
	set +e
	wait "${peer_listener_pid}"
	listener_status=$?
	if (( listener_status != 0 )) && kill -0 "${peer_initiator_pid}" 2>/dev/null; then kill -TERM "${peer_initiator_pid}" 2>/dev/null || true; fi
	wait "${peer_initiator_pid}"
	initiator_status=$?
	set -e
	if (( listener_status != 0 )); then
		mpudp_it_die "Bob expiry Peer exited ${listener_status}; see ${peer_listener_log}"
		return 1
	fi
	if (( initiator_status != 0 )); then
		mpudp_it_die "Alice expiry Peer exited ${initiator_status}; see ${peer_initiator_log}"
		return 1
	fi
	record_peer_events
	grep -q '"event":"endpoint_expired","phase":"expiry".*"error_kinds":\["no_available_paths"\]' \
		"${peer_listener_events}" || { mpudp_it_die "Endpoint expiry did not classify ErrNoAvailablePaths"; return 1; }
	wait_started=$(sed -n 's/.*"event":"expiry_wait_started".*"elapsed_ms":\([0-9][0-9]*\).*/\1/p' "${peer_listener_events}" | sed -n '1p')
	expired=$(sed -n 's/.*"event":"endpoint_expired".*"elapsed_ms":\([0-9][0-9]*\).*/\1/p' "${peer_listener_events}" | sed -n '1p')
	if [[ ! ${wait_started} =~ ^[0-9]+$ || ! ${expired} =~ ^[0-9]+$ ]]; then
		mpudp_it_die "Endpoint expiry timing metadata is missing"
		return 1
	fi
	elapsed=$((expired - wait_started))
	if (( elapsed < 5000 )); then
		mpudp_it_die "Endpoint expiry fired after ${elapsed}ms of quiet time, want at least 5000ms"
		return 1
	fi
	accepted_count=$(grep -c '"event":"session_accepted"' "${peer_listener_events}" || true)
	if [[ ${accepted_count} != 1 ]]; then
		mpudp_it_die "Bob expiry flow accepted ${accepted_count} Sessions, want 1"
		return 1
	fi
	grep -q '"event":"datagram_received","phase":"bootstrap","bytes":96' "${peer_listener_events}" || {
		mpudp_it_die "Bob expiry Session did not receive bootstrap traffic"
		return 1
	}
	mpudp_it_log "case passed: ${case_name} (same accepted Session returned ErrNoAvailablePaths after ${elapsed}ms quiet)"
}

run_raw_nat_smoke() {
	local family=$1 network listen_address nft_family table alice_ns bob_ns targets
	local server_events client_events ready_file server_log client_log server_pid server_status
	local -a fragment_pids=() fragment_event_files=() fragment_log_files=()
	build_netprobe
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	if [[ ${family} == 4 ]]; then
		network=udp4; listen_address=0.0.0.0:9000; nft_family=ip; table=${MPUDP_IT_TABLE4}
	else
		network=udp6; listen_address='[::]:9000'; nft_family=ip6; table=${MPUDP_IT_TABLE6}
	fi
	targets=$(mpudp_it_join_targets "${family}")
	server_events=${MPUDP_IT_STATE_DIR}/${case_name}-server.ndjson
	client_events=${MPUDP_IT_STATE_DIR}/${case_name}-client.ndjson
	ready_file=${MPUDP_IT_STATE_DIR}/${case_name}.ready
	server_log=${MPUDP_IT_STATE_DIR}/${case_name}-server.log
	client_log=${MPUDP_IT_STATE_DIR}/${case_name}-client.log
	: >"${server_events}"
	: >"${client_events}"
	: >"${server_log}"
	: >"${client_log}"
	rm -f -- "${ready_file}"

	for path in 1 2 3 4 5; do
		if [[ -n $(ip netns pids "$(mpudp_it_ns "t${path}")") ]]; then
			mpudp_it_die "T${path} unexpectedly runs a process"
			return 1
		fi
		bob_address=$(mpudp_it_bob_addr "${family}" "${path}")
		if ip -n "${alice_ns}" -"${family}" route get "${bob_address}" >/dev/null 2>&1; then
			mpudp_it_die "Alice unexpectedly has a route to Bob path ${path}"
			return 1
		fi
	done
	start_fragment_observers "${family}"

	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${bob_ns}" "${netprobe}" \
		--mode server --network "${network}" --listen "${listen_address}" --count 5 \
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" \
		--events "${server_events}" --ready-file "${ready_file}" \
		>"${server_log}" 2>&1 &
	server_pid=$!
	mpudp_it_record_pid "${server_pid}"
	if ! wait_ready "${ready_file}" "${server_pid}"; then
		mpudp_it_die "Bob netprobe did not become ready; see ${server_log}"
		return 1
	fi

	if ! timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${alice_ns}" "${netprobe}" \
		--mode client --network "${network}" --targets "${targets}" \
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${client_events}" \
		>"${client_log}" 2>&1; then
		mpudp_it_die "Alice netprobe failed; see ${client_log}"
		return 1
	fi
	set +e
	wait "${server_pid}"
	server_status=$?
	set -e
	if (( server_status != 0 )); then
		mpudp_it_die "Bob netprobe exited ${server_status}; see ${server_log}"
		return 1
	fi
	if ! stop_fragment_observers; then
		mpudp_it_die "one or more wire-fragment observers exited unexpectedly"
		return 1
	fi
	assert_no_wire_fragments

	if [[ $(awk 'END {print NR}' "${server_events}") != 5 || $(awk 'END {print NR}' "${client_events}") != 5 ]]; then
		mpudp_it_die "smoke event count is not 5 server + 5 client"
		return 1
	fi
	if grep -Eq 'payload|psk|authentication_tag|hmac' "${server_events}" "${client_events}"; then
		mpudp_it_die "event metadata contains a forbidden sensitive field name"
		return 1
	fi
	for path in 1 2 3 4 5; do
		t_ns=$(mpudp_it_ns "t${path}")
		assert_counter_at_least "${t_ns}" "${nft_family}" "${table}" mpudp-forward 1
		assert_counter_at_least "${t_ns}" "${nft_family}" "${table}" mpudp-reverse 1
		assert_counter_equal "${t_ns}" "${nft_family}" "${table}" mpudp-fragment 0
	done
	sed -n 'p' "${server_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	sed -n 'p' "${client_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	mpudp_it_log "case passed: ${case_name} (five NAT replies; lossless wire capture observed zero fragments)"
}

run_path_controls() {
	local family=$1 alice_ns t1_ns t2_ns t3_ns t4_ns t5_ns family_flag minimum
	local network listen_address drop_target drop_server_events drop_client_events drop_ready_file
	local drop_server_log drop_blocked_log drop_allowed_log drop_server_pid drop_server_status
	build_netprobe
	alice_ns=$(mpudp_it_ns alice)
	t1_ns=$(mpudp_it_ns t1); t2_ns=$(mpudp_it_ns t2); t3_ns=$(mpudp_it_ns t3)
	t4_ns=$(mpudp_it_ns t4); t5_ns=$(mpudp_it_ns t5)
	family_flag=-4; minimum=576
	network=udp4; listen_address=0.0.0.0:9000
	if [[ ${family} == 6 ]]; then family_flag=-6; minimum=1280; network=udp6; listen_address='[::]:9000'; fi

	cleanup_controls() {
		for cleanup_path in 1 2 3 4 5; do
			"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem --path "${cleanup_path}" --family "${family}" --direction both >/dev/null 2>&1 || true
			"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" link --path "${cleanup_path}" --family "${family}" up >/dev/null 2>&1 || true
			"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu --path "${cleanup_path}" --family "${family}" --value 1500 >/dev/null 2>&1 || true
			"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-drop --path "${cleanup_path}" --family "${family}" >/dev/null 2>&1 || true
		done
	}
	trap cleanup_controls RETURN

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" netem --path 1 --family "${family}" --delay 5ms --loss 0% --reorder 25%
	if ! ip netns exec "${alice_ns}" tc qdisc show dev "$(mpudp_it_alice_if "${family}" 1)" | grep netem >/dev/null; then
		mpudp_it_die "path 1 netem was not installed"
		return 1
	fi
	if ip netns exec "${alice_ns}" tc qdisc show dev "$(mpudp_it_alice_if "${family}" 2)" | grep netem >/dev/null; then
		mpudp_it_die "path 1 netem changed path 2"
		return 1
	fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem --path 1 --family "${family}" --direction both

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" netem --path 2 --family "${family}" --loss 100%
	if ip netns exec "${alice_ns}" ping "${family_flag}" -c 1 -W 1 "$(mpudp_it_t_ingress_addr "${family}" 2)" >/dev/null 2>&1; then
		mpudp_it_die "100% loss on path 2 still passed traffic"
		return 1
	fi
	if ! ip netns exec "${alice_ns}" ping "${family_flag}" -c 1 -W 1 "$(mpudp_it_t_ingress_addr "${family}" 1)" >/dev/null; then
		mpudp_it_die "path 2 loss affected path 1"
		return 1
	fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem --path 2 --family "${family}" --direction both

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" link --path 3 --family "${family}" down
	if ip netns exec "${alice_ns}" ping "${family_flag}" -c 1 -W 1 "$(mpudp_it_t_ingress_addr "${family}" 3)" >/dev/null 2>&1; then
		mpudp_it_die "link-down path 3 still passed traffic"
		return 1
	fi
	if ! ip netns exec "${alice_ns}" ping "${family_flag}" -c 1 -W 1 "$(mpudp_it_t_ingress_addr "${family}" 4)" >/dev/null; then
		mpudp_it_die "path 3 link-down affected path 4"
		return 1
	fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" link --path 3 --family "${family}" up

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu --path 5 --family "${family}" --value "${minimum}"
	for target in \
		"${alice_ns}:$(mpudp_it_alice_if "${family}" 5)" \
		"${t5_ns}:$(mpudp_it_t_in_if "${family}")" \
		"${t5_ns}:$(mpudp_it_t_out_if "${family}")" \
		"$(mpudp_it_ns bob):$(mpudp_it_bob_if "${family}" 5)"; do
		namespace=${target%%:*}; interface=${target#*:}
		got=$(ip -n "${namespace}" -o link show dev "${interface}" | awk '{for (i=1; i<=NF; i++) if ($i == "mtu") {print $(i+1); exit}}')
		if [[ ${got} != "${minimum}" ]]; then mpudp_it_die "${namespace}/${interface} MTU=${got}, want ${minimum}"; return 1; fi
	done
	other_mtu=$(ip -n "${alice_ns}" -o link show dev "$(mpudp_it_alice_if "${family}" 4)" | awk '{for (i=1; i<=NF; i++) if ($i == "mtu") {print $(i+1); exit}}')
	if [[ ${other_mtu} != 1500 ]]; then mpudp_it_die "path 5 MTU changed path 4"; return 1; fi
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu --path 5 --family "${family}" --value 1500

	table=${MPUDP_IT_TABLE4}; nft_family=ip
	if [[ ${family} == 6 ]]; then table=${MPUDP_IT_TABLE6}; nft_family=ip6; fi
	drop_target=$(mpudp_it_target "${family}" 1)
	drop_server_events=${MPUDP_IT_STATE_DIR}/${case_name}-drop-server.ndjson
	drop_client_events=${MPUDP_IT_STATE_DIR}/${case_name}-drop-client.ndjson
	drop_ready_file=${MPUDP_IT_STATE_DIR}/${case_name}-drop.ready
	drop_server_log=${MPUDP_IT_STATE_DIR}/${case_name}-drop-server.log
	drop_blocked_log=${MPUDP_IT_STATE_DIR}/${case_name}-drop-blocked.log
	drop_allowed_log=${MPUDP_IT_STATE_DIR}/${case_name}-drop-allowed.log
	: >"${drop_server_events}"; : >"${drop_client_events}"; : >"${drop_server_log}"
	: >"${drop_blocked_log}"; : >"${drop_allowed_log}"; rm -f -- "${drop_ready_file}"
	timeout --signal=TERM --kill-after=2s 8s \
		ip netns exec "$(mpudp_it_ns bob)" "${netprobe}" \
		--mode server --network "${network}" --listen "${listen_address}" --count 1 \
		--timeout 6s --run-id "${MPUDP_IT_RUN_ID}" --events "${drop_server_events}" --ready-file "${drop_ready_file}" \
		>"${drop_server_log}" 2>&1 &
	drop_server_pid=$!
	mpudp_it_record_pid "${drop_server_pid}"
	if ! wait_ready "${drop_ready_file}" "${drop_server_pid}"; then
		mpudp_it_die "Bob drop-match probe did not become ready; see ${drop_server_log}"
		return 1
	fi

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" drop-match --path 1 --family "${family}" --offset 0 --hex 6d707564
	if ! ip netns exec "${t1_ns}" nft list chain "${nft_family}" "${table}" forward | grep mpudp-drop-0-6d707564 >/dev/null; then
		mpudp_it_die "precise payload drop rule was not installed"
		return 1
	fi
	if timeout --signal=TERM --kill-after=1s 3s \
		ip netns exec "${alice_ns}" "${netprobe}" \
		--mode client --network "${network}" --targets "${drop_target}" --timeout 1s \
		--run-id "${MPUDP_IT_RUN_ID}" --events "${drop_client_events}" >"${drop_blocked_log}" 2>&1; then
		mpudp_it_die "payload-matched datagram unexpectedly crossed path 1"
		return 1
	fi
	assert_counter_at_least "${t1_ns}" "${nft_family}" "${table}" mpudp-drop-0-6d707564 1
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-drop --path 1 --family "${family}"
	if ! timeout --signal=TERM --kill-after=1s 4s \
		ip netns exec "${alice_ns}" "${netprobe}" \
		--mode client --network "${network}" --targets "${drop_target}" --timeout 3s \
		--run-id "${MPUDP_IT_RUN_ID}" --events "${drop_client_events}" >"${drop_allowed_log}" 2>&1; then
		mpudp_it_die "datagram did not recover after clearing the payload match; see ${drop_allowed_log}"
		return 1
	fi
	set +e
	wait "${drop_server_pid}"
	drop_server_status=$?
	set -e
	if (( drop_server_status != 0 )); then
		mpudp_it_die "Bob drop-match probe exited ${drop_server_status}; see ${drop_server_log}"
		return 1
	fi
	if [[ $(awk 'END {print NR}' "${drop_server_events}") != 1 || $(awk 'END {print NR}' "${drop_client_events}") != 1 ]]; then
		mpudp_it_die "drop-match behavioral event count is not 1 server + 1 client"
		return 1
	fi

	cleanup_controls
	trap - RETURN
	mpudp_it_log "case passed: ${case_name} (delay/loss/reorder/link/MTU/drop controls isolated)"
}

