			return 1
		fi
	done
}

assert_udp_length_all_paths() {
	local expected=$1 index
	for index in "${!udp_event_files[@]}"; do
		if ! grep -q "UDP, length ${expected}$" "${udp_event_files[${index}]}"; then
			mpudp_it_die "T$((index + 1)) did not observe UDP payload length ${expected}"
			return 1
		fi
	done
}

assert_udp_length_paths() {
	local expected=$1 path
	shift
	for path in "$@"; do
		if ! grep -q "UDP, length ${expected}$" "${udp_event_files[$((path - 1))]}"; then
			mpudp_it_die "T${path} did not observe UDP payload length ${expected}"
			return 1
		fi
	done
}

assert_udp_length_absent() {
	local expected=$1 path=$2
	if grep -q "UDP, length ${expected}$" "${udp_event_files[$((path - 1))]}"; then
		mpudp_it_die "T${path} unexpectedly observed UDP payload length ${expected}"
		return 1
	fi
}

udp_direction_pattern() {
	local direction=$1 expected=$2
	case ${direction} in
		forward) printf '> [^ ]+\\.9000: UDP, length %s$\n' "${expected}" ;;
		reverse) printf '\\.9000 > [^ ]+: UDP, length %s$\n' "${expected}" ;;
		*) mpudp_it_die "invalid UDP assertion direction: ${direction}"; return 1 ;;
	esac
}

assert_udp_length_all_paths_direction() {
	local expected=$1 direction=$2 pattern index
	pattern=$(udp_direction_pattern "${direction}" "${expected}")
	for index in "${!udp_event_files[@]}"; do
		if ! grep -Eq "${pattern}" "${udp_event_files[${index}]}"; then
			mpudp_it_die "T$((index + 1)) did not observe ${direction} UDP payload length ${expected}"
			return 1
		fi
	done
}

assert_udp_length_paths_direction() {
	local expected=$1 direction=$2 pattern path
	shift 2
	pattern=$(udp_direction_pattern "${direction}" "${expected}")
	for path in "$@"; do
		if ! grep -Eq "${pattern}" "${udp_event_files[$((path - 1))]}"; then
			mpudp_it_die "T${path} did not observe ${direction} UDP payload length ${expected}"
			return 1
		fi
	done
}

assert_udp_length_absent_direction() {
	local expected=$1 direction=$2 path=$3 pattern
	pattern=$(udp_direction_pattern "${direction}" "${expected}")
	if grep -Eq "${pattern}" "${udp_event_files[$((path - 1))]}"; then
		mpudp_it_die "T${path} unexpectedly observed ${direction} UDP payload length ${expected}"
		return 1
	fi
}

assert_udp_lengths_at_most() {
	local maximum=$1 index offending
	for index in "${!udp_event_files[@]}"; do
		offending=$(awk -v maximum="${maximum}" '
			NF && ($(NF-1) != "length" || $NF !~ /^[0-9]+$/ || $NF > maximum) {print; exit}
		' "${udp_event_files[${index}]}")
		if [[ -n ${offending} ]]; then
			mpudp_it_die "T$((index + 1)) observed malformed or over-budget UDP metadata: ${offending}"
			return 1
		fi
	done
}

snapshot_udp_event_counts() {
	local index
	udp_event_counts=()
	for index in "${!udp_event_files[@]}"; do
		udp_event_counts+=("$(awk 'END {print NR+0}' "${udp_event_files[${index}]}")")
	done
}

assert_udp_event_counts_unchanged() {
	local index current
	for index in "${!udp_event_files[@]}"; do
		current=$(awk 'END {print NR+0}' "${udp_event_files[${index}]}")
		if [[ ${current} != "${udp_event_counts[${index}]}" ]]; then
			mpudp_it_die "T$((index + 1)) emitted UDP traffic during the rejected oversize write"
			return 1
		fi
	done
}

wait_for_udp_source_port() {
	local path=$1 port=$2 attempt file
	file=${udp_event_files[$((path - 1))]}
	for attempt in $(seq 1 100); do
		if grep -Eq "\.${port} > .*\.9000:" "${file}"; then return 0; fi
		sleep 0.05
	done
	mpudp_it_die "T${path} did not observe Bob-facing NAT source port ${port}"
	return 1
}

assert_socket_snapshots_equal() {
	local before=$1 after=$2 difference=$3
	if ! diff -u \
		<(awk '$4 ~ /:4000$/ {print $3, $4}' "${before}" | sort) \
		<(awk '$4 ~ /:4000$/ {print $3, $4}' "${after}" | sort) >"${difference}"; then
		mpudp_it_die "Alice Carrier socket identities changed during the controlled phase"
		return 1
	fi
}

assert_five_carrier_sockets() {
	local family=$1 label=${2:-} alice_ns snapshot path socket_count unique_count address
	alice_ns=$(mpudp_it_ns alice)
	snapshot=${MPUDP_IT_STATE_DIR}/${case_name}${label:+-${label}}-alice-sockets.log
	ip netns exec "${alice_ns}" ss -H -u -n -p >"${snapshot}"
	socket_count=$(awk '$4 ~ /:4000$/ {count++} END {print count+0}' "${snapshot}")
	unique_count=$(awk '$4 ~ /:4000$/ {print $3}' "${snapshot}" | sort -u | awk 'END {print NR}')
	if [[ ${socket_count} != 5 || ${unique_count} != 5 ]]; then
		mpudp_it_die "Alice Carrier sockets=${socket_count}, unique local identities=${unique_count}, want 5/5"
		return 1
	fi
	for path in 1 2 3 4 5; do
		address=$(mpudp_it_t_ingress_addr "${family}" "${path}")
		if ! grep -F "${address}" "${snapshot}" | grep ':4000' >/dev/null; then
			mpudp_it_die "Alice has no connected Carrier socket for T${path} ${address}:4000"
			return 1
		fi
	done
}

start_peer_exchange() {
	local family=$1 flow=$2 listener_budget=$3 initiator_budget=$4 body_bytes=$5 reply_bytes=$6
	local oversize_bytes=$7 expect_partial_mtu=$8 reject_second_session=$9
	local targets_override=${10:-} endpoint_ttl=${11:-} keepalive=${12:-} expiry_wait=${13:-}
	local alice_ns bob_ns listen_address targets peer_start_marker peer_start_phase
	local -a listener_arguments initiator_arguments
	build_peerprobe
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	listen_address=0.0.0.0:9000
	if [[ ${family} == 6 ]]; then listen_address='[::]:9000'; fi
	targets=$(mpudp_it_join_targets "${family}")
	if [[ -n ${targets_override} ]]; then targets=${targets_override}; fi
	peer_listener_events=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}-bob.ndjson
	peer_initiator_events=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}-alice.ndjson
	peer_listener_log=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}-bob.log
	peer_initiator_log=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}-alice.log
	peer_ready_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.ready
	peer_oversize_ready_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.oversize-ready
	peer_oversize_continue_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.oversize-continue
	peer_oversize_done_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.oversize-done
	peer_phase_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.phase
	peer_continue_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.continue
	peer_reply_complete_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.reply-complete
	peer_exit_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.exit
	peer_final_file=${MPUDP_IT_STATE_DIR}/${case_name}-${flow}.final
	peer_exchange_released=0
	peer_oversize_released=0
	peer_has_oversize=0
	rm -f -- "${peer_ready_file}" "${peer_oversize_ready_file}" "${peer_oversize_continue_file}" \
		"${peer_oversize_done_file}" "${peer_phase_file}" "${peer_continue_file}" "${peer_reply_complete_file}" \
		"${peer_exit_file}" "${peer_final_file}" "${peer_final_file}.post-expiry-done"
	: >"${peer_listener_log}"
	: >"${peer_initiator_log}"
	listener_arguments=(
		--role listener --flow "${flow}" --family "${family}" --listen "${listen_address}"
		--max-udp-payload "${listener_budget}" --body-bytes "${body_bytes}" --reply-bytes "${reply_bytes}"
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${peer_listener_events}"
		--ready-file "${peer_ready_file}" --reply-complete-file "${peer_reply_complete_file}"
		--exit-file "${peer_exit_file}" --final-file "${peer_final_file}"
	)
	if [[ ${reject_second_session} == true ]]; then listener_arguments+=(--reject-second-session); fi
	if [[ -n ${endpoint_ttl} ]]; then listener_arguments+=(--endpoint-ttl "${endpoint_ttl}"); fi
	if [[ -n ${keepalive} ]]; then listener_arguments+=(--keepalive "${keepalive}"); fi
	if [[ -n ${expiry_wait} ]]; then listener_arguments+=(--expiry-wait "${expiry_wait}"); fi
	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${bob_ns}" "${peerprobe}" "${listener_arguments[@]}" >"${peer_listener_log}" 2>&1 &
	peer_listener_pid=$!
	mpudp_it_record_pid "${peer_listener_pid}"
	if ! wait_ready "${peer_ready_file}" "${peer_listener_pid}"; then
		mpudp_it_die "Bob public Peer did not become ready; see ${peer_listener_log}"
		return 1
	fi

	initiator_arguments=(
		--role initiator --flow "${flow}" --family "${family}" --carriers "${targets}"
		--max-udp-payload "${initiator_budget}" --body-bytes "${body_bytes}" --reply-bytes "${reply_bytes}"
		--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${peer_initiator_events}"
		--phase-file "${peer_phase_file}" --continue-file "${peer_continue_file}"
		--reply-complete-file "${peer_reply_complete_file}" --exit-file "${peer_exit_file}"
		--final-file "${peer_final_file}"
	)
	if [[ -n ${endpoint_ttl} ]]; then initiator_arguments+=(--endpoint-ttl "${endpoint_ttl}"); fi
	if [[ -n ${keepalive} ]]; then initiator_arguments+=(--keepalive "${keepalive}"); fi
	if [[ -n ${expiry_wait} ]]; then initiator_arguments+=(--expiry-wait "${expiry_wait}"); fi
	if (( oversize_bytes != 0 )); then
		peer_has_oversize=1
		initiator_arguments+=(
			--oversize-bytes "${oversize_bytes}"
			--oversize-ready-file "${peer_oversize_ready_file}"
			--oversize-continue-file "${peer_oversize_continue_file}"
			--oversize-done-file "${peer_oversize_done_file}"
		)
	fi
	if [[ ${expect_partial_mtu} == true ]]; then initiator_arguments+=(--expect-partial-mtu); fi
	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${alice_ns}" "${peerprobe}" "${initiator_arguments[@]}" >"${peer_initiator_log}" 2>&1 &
	peer_initiator_pid=$!
	mpudp_it_record_pid "${peer_initiator_pid}"
	peer_start_marker=${peer_phase_file}
	peer_start_phase=main
	if (( peer_has_oversize != 0 )); then
		peer_start_marker=${peer_oversize_ready_file}
		peer_start_phase=oversize
	fi
	if ! wait_ready "${peer_start_marker}" "${peer_initiator_pid}"; then
		mpudp_it_die "Alice public Peer did not reach the ${peer_start_phase} phase; see ${peer_initiator_log}"
		return 1
	fi
}

release_peer_oversize() {
	if (( peer_has_oversize == 0 )); then
		mpudp_it_die "public Peer exchange has no oversize phase"
		return 1
	fi
	if (( peer_oversize_released != 0 )); then return 0; fi
	printf 'continue\n' >"${peer_oversize_continue_file}"
	if ! wait_ready "${peer_oversize_done_file}" "${peer_initiator_pid}"; then
		mpudp_it_die "Alice public Peer did not finish the rejected oversize write; see ${peer_initiator_log}"
		return 1
	fi
	if ! wait_ready "${peer_phase_file}" "${peer_initiator_pid}"; then
		mpudp_it_die "Alice public Peer did not reach the main phase; see ${peer_initiator_log}"
		return 1
	fi
	peer_oversize_released=1
}

release_peer_exchange() {
	if (( peer_exchange_released != 0 )); then return 0; fi
	if (( peer_has_oversize != 0 && peer_oversize_released == 0 )); then
		mpudp_it_die "oversize evidence must complete before the main exchange is released"
		return 1
	fi
	printf 'continue\n' >"${peer_continue_file}"
	if ! wait_ready "${peer_exit_file}" "${peer_initiator_pid}"; then
		mpudp_it_die "Alice public Peer did not finish the main exchange; see ${peer_initiator_log}"
		return 1
	fi
	peer_exchange_released=1
}

record_peer_events() {
	if grep -Fqi 'integration-test-key' "${peer_listener_events}" "${peer_initiator_events}" ||
		grep -Eqi '"(payload|psk|authentication[_-]?tag|hmac|session_id)"[[:space:]]*:' \
			"${peer_listener_events}" "${peer_initiator_events}"; then
		mpudp_it_die "public Peer event metadata contains a forbidden sensitive field"
		return 1
	fi
	sed -n 'p' "${peer_listener_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	sed -n 'p' "${peer_initiator_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
}

finish_peer_exchange() {
	local initiator_status listener_status
	release_peer_exchange
	printf 'finish\n' >"${peer_final_file}"
	set +e
	wait "${peer_initiator_pid}"
	initiator_status=$?
	if (( initiator_status != 0 )) && kill -0 "${peer_listener_pid}" 2>/dev/null; then kill -TERM "${peer_listener_pid}" 2>/dev/null || true; fi
	wait "${peer_listener_pid}"
	listener_status=$?
	set -e
	if (( initiator_status != 0 )); then
		mpudp_it_die "Alice public Peer exited ${initiator_status}; see ${peer_initiator_log}"
		return 1
	fi
	if (( listener_status != 0 )); then
		mpudp_it_die "Bob public Peer exited ${listener_status}; see ${peer_listener_log}"
		return 1
	fi
	record_peer_events
}

remove_nft_rules_with_comment() {
	local namespace=$1 nft_family=$2 table=$3 chain=$4 comment=$5 handle status=0
	local -a handles=()
	mapfile -t handles < <(
		ip netns exec "${namespace}" nft -a list chain "${nft_family}" "${table}" "${chain}" 2>/dev/null |
			awk -v marker="comment \"${comment}\"" 'index($0, marker) {for (i=1; i<=NF; i++) if ($i == "handle") print $(i+1)}'
	)
	for handle in "${handles[@]}"; do
		if ! ip netns exec "${namespace}" nft delete rule "${nft_family}" "${table}" "${chain}" handle "${handle}"; then
			status=1
		fi
	done
	return "${status}"
}

cleanup_direct_single_carrier() {
	local marker=${direct_mutation_file:-${MPUDP_IT_STATE_DIR:-}/direct-single-carrier.direct-mutations}
	local alice_ns bob_ns t_ns alice_address bob_address alice_gateway bob_gateway direct_comment status=0
	if [[ -z ${MPUDP_IT_STATE_DIR:-} || ! -f ${marker} ]]; then return 0; fi
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	t_ns=$(mpudp_it_ns t1)
	alice_address=$(mpudp_it_alice_addr 4 1)
	bob_address=$(mpudp_it_bob_addr 4 1)
	alice_gateway=$(mpudp_it_t_ingress_addr 4 1)
	bob_gateway=$(mpudp_it_t_egress_addr 4 1)
	remove_nft_rules_with_comment "${t_ns}" ip "${MPUDP_IT_TABLE4}" forward mpudp-direct-forward || status=1
	remove_nft_rules_with_comment "${t_ns}" ip "${MPUDP_IT_TABLE4}" forward mpudp-direct-reverse || status=1
	remove_nft_rules_with_comment "${t_ns}" ip "${MPUDP_IT_TABLE4}" postrouting mpudp-direct-no-snat || status=1
	ip -n "${alice_ns}" -4 route del "${bob_address}/32" via "${alice_gateway}" dev a4p1 2>/dev/null || true
	ip -n "${bob_ns}" -4 route del "${alice_address}/32" via "${bob_gateway}" dev b4p1 2>/dev/null || true
	if [[ -n $(ip -n "${alice_ns}" -4 route show exact "${bob_address}/32") ||
		-n $(ip -n "${bob_ns}" -4 route show exact "${alice_address}/32") ]]; then
		mpudp_it_die "direct single-Carrier host routes remain after cleanup"
		status=1
	fi
	for direct_comment in mpudp-direct-forward mpudp-direct-reverse mpudp-direct-no-snat; do
		if ip netns exec "${t_ns}" nft -a list table ip "${MPUDP_IT_TABLE4}" |
			awk -v marker="comment \"${direct_comment}\"" 'index($0, marker) {found=1} END {exit !found}'; then
			mpudp_it_die "direct single-Carrier nft rule remains after cleanup: ${direct_comment}"
			status=1
		fi
	done
	if (( status == 0 )); then rm -f -- "${marker}"; fi
	return "${status}"
}

cleanup_canonical_rebinding() {
	local marker=${canonical_rebinding_mutation_file:-${MPUDP_IT_STATE_DIR:-}/endpoint-rebinding-and-expiry.mutations}
	local t1_ns cleanup_path status=0
	if [[ -z ${MPUDP_IT_STATE_DIR:-} || ! -f ${marker} ]]; then return 0; fi
	t1_ns=$(mpudp_it_ns t1)
	for cleanup_path in 2 3; do
		if ! "${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem \
			--path "${cleanup_path}" --family 4 --direction forward >/dev/null 2>&1; then
			status=1
		fi
	done
	if ! remove_nft_rules_with_comment "${t1_ns}" ip "${MPUDP_IT_TABLE4}" forward \
		mpudp-expired-endpoint-drop >/dev/null 2>&1; then
		status=1
	fi
	if ! "${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-rebind \
		--path 1 --family 4 >/dev/null 2>&1; then
		status=1
	fi
	for cleanup_path in 2 3; do
		if ip netns exec "$(mpudp_it_ns alice)" tc qdisc show dev "a4p${cleanup_path}" |
			awk '$2 == "netem" {found=1} END {exit !found}'; then
			mpudp_it_die "canonical rebinding netem remains on path ${cleanup_path}"
			status=1
		fi
	done
	if ip netns exec "${t1_ns}" nft -a list table ip "${MPUDP_IT_TABLE4}" |
		awk '/comment "mpudp-(rebind-|expired-endpoint-drop)/ {found=1} END {exit !found}'; then
		mpudp_it_die "canonical rebinding nft rule remains after cleanup"
		status=1
	fi
	if (( status == 0 )); then rm -f -- "${marker}"; fi
	return "${status}"
}

cleanup_canonical_mtu() {
	local marker=${canonical_mtu_mutation_file:-${MPUDP_IT_STATE_DIR:-}/mtu-budget-no-fragment.mutations}
	local family namespace interface current status=0
	if [[ -z ${MPUDP_IT_STATE_DIR:-} || ! -f ${marker} ]]; then return 0; fi
	for family in 4 6; do
		if ! "${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" mtu \
			--path 1 --family "${family}" --value 1500 >/dev/null 2>&1; then
			status=1
		fi
		while read -r namespace interface; do
			current=$(ip -n "${namespace}" -o link show dev "${interface}" |
				awk '{for (i=1; i<=NF; i++) if ($i == "mtu") {print $(i+1); exit}}')
			if [[ ${current} != 1500 ]]; then
				mpudp_it_die "canonical MTU cleanup left ${namespace}/${interface} at ${current:-unknown}"
				status=1
			fi
		done < <(printf '%s %s\n' \
			"$(mpudp_it_ns alice)" "a${family}p1" \
			"$(mpudp_it_ns t1)" "in${family}" \
			"$(mpudp_it_ns t1)" "out${family}" \
			"$(mpudp_it_ns bob)" "b${family}p1")
	done
	if (( status == 0 )); then rm -f -- "${marker}"; fi
	return "${status}"
}

cleanup_shutdown_mutations() {
	local marker=${shutdown_mutation_file:-${MPUDP_IT_STATE_DIR:-}/shutdown-cleanup.mutations}
	local cleanup_path t_ns status=0
	if [[ -z ${MPUDP_IT_STATE_DIR:-} || ! -f ${marker} ]]; then return 0; fi
	for cleanup_path in 1 2 3 4 5; do
		if ! "${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem \
			--path "${cleanup_path}" --family 4 --direction both >/dev/null 2>&1; then
			status=1
		fi
		if ! "${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-drop \
			--path "${cleanup_path}" --family 4 >/dev/null 2>&1; then
			status=1
		fi
		t_ns=$(mpudp_it_ns "t${cleanup_path}")
		if ip netns exec "${t_ns}" nft list chain ip "${MPUDP_IT_TABLE4}" forward |
			awk '/comment "mpudp-drop-/ {found=1} END {exit !found}'; then
			mpudp_it_die "shutdown shard-drop rule remains on path ${cleanup_path}"
			status=1
		fi
	done
	if ! assert_no_netem 4; then status=1; fi
	if (( status == 0 )); then rm -f -- "${marker}"; fi
	return "${status}"
}

configure_direct_single_carrier() {
	local alice_ns bob_ns t_ns alice_address bob_address alice_gateway bob_gateway
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	t_ns=$(mpudp_it_ns t1)
	alice_address=$(mpudp_it_alice_addr 4 1)
	bob_address=$(mpudp_it_bob_addr 4 1)
	alice_gateway=$(mpudp_it_t_ingress_addr 4 1)
	bob_gateway=$(mpudp_it_t_egress_addr 4 1)
	if [[ -n $(ip -n "${alice_ns}" -4 route show exact "${bob_address}/32") ||
		-n $(ip -n "${bob_ns}" -4 route show exact "${alice_address}/32") ]]; then
		mpudp_it_die "direct single-Carrier route already exists outside case ownership"
		return 1
	fi
	direct_mutation_file=${MPUDP_IT_STATE_DIR}/direct-single-carrier.direct-mutations
	: >"${direct_mutation_file}"
	ip -n "${alice_ns}" -4 route add "${bob_address}/32" via "${alice_gateway}" dev a4p1
	ip -n "${bob_ns}" -4 route add "${alice_address}/32" via "${bob_gateway}" dev b4p1
	ip netns exec "${t_ns}" nft insert rule ip "${MPUDP_IT_TABLE4}" postrouting \
		ip saddr "${alice_address}" ip daddr "${bob_address}" udp dport 9000 \
		counter return comment mpudp-direct-no-snat
	ip netns exec "${t_ns}" nft insert rule ip "${MPUDP_IT_TABLE4}" forward \
		iifname in4 oifname out4 ip saddr "${alice_address}" ip daddr "${bob_address}" udp dport 9000 \
		counter accept comment mpudp-direct-forward
	ip netns exec "${t_ns}" nft insert rule ip "${MPUDP_IT_TABLE4}" forward \
		iifname out4 oifname in4 ip saddr "${bob_address}" ip daddr "${alice_address}" udp sport 9000 \
		counter accept comment mpudp-direct-reverse
}

counter_for_rule_fragments() {
	local namespace=$1 nft_family=$2 table=$3 chain=$4 first=$5 second=$6
	ip netns exec "${namespace}" nft list chain "${nft_family}" "${table}" "${chain}" |
		awk -v first="${first}" -v second="${second}" '
			index($0, first) && index($0, second) {
				for (i=1; i<=NF; i++) if ($i == "packets") {print $(i+1); exit}
			}
		'
}

capture_single_direct_carrier() {
	local label=$1 alice_ns target snapshot tuple local_endpoint local_address local_port minimum maximum
	alice_ns=$(mpudp_it_ns alice)
	target=$(mpudp_it_bob_addr 4 1):9000
	snapshot=${MPUDP_IT_STATE_DIR}/${case_name}-${label}-alice-sockets.log
	tuple=${MPUDP_IT_STATE_DIR}/${case_name}-${label}-alice-carrier-tuple.log
	ip netns exec "${alice_ns}" ss -H -u -n >"${snapshot}"
	if [[ $(awk 'NF {count++} END {print count+0}' "${snapshot}") != 1 ||
		$(awk -v target="${target}" '$4 == target {count++} END {print count+0}' "${snapshot}") != 1 ]]; then
		mpudp_it_die "Alice does not have exactly one connected UDP Carrier to ${target}"
		return 1
	fi
	awk -v target="${target}" '$4 == target {print $3, $4}' "${snapshot}" >"${tuple}"
	read -r local_endpoint _ <"${tuple}"
	local_address=${local_endpoint%:*}
	local_port=${local_endpoint##*:}
	read -r minimum maximum < <(ip netns exec "${alice_ns}" cat /proc/sys/net/ipv4/ip_local_port_range)
	if [[ ${local_address} != "$(mpudp_it_alice_addr 4 1)" || ! ${local_port} =~ ^[0-9]+$ ||
		! ${minimum} =~ ^[0-9]+$ || ! ${maximum} =~ ^[0-9]+$ ]] ||
		(( local_port < minimum || local_port > maximum )); then
		mpudp_it_die "Alice Carrier source is not an OS-assigned path-1 tuple"
		return 1
	fi
	direct_tuple_file=${tuple}
	direct_source_port=${local_port}
}

assert_direct_wire_metadata() {
	local source_port=$1 alice_address bob_address source_endpoint reverse_endpoint offending line_count index
	alice_address=$(mpudp_it_alice_addr 4 1)
	bob_address=$(mpudp_it_bob_addr 4 1)
	source_endpoint=${alice_address}.${source_port}
	reverse_endpoint=${bob_address}.9000
	line_count=$(awk 'NF {count++} END {print count+0}' "${udp_event_files[0]}")
	if (( line_count == 0 || line_count > 256 )); then
		mpudp_it_die "T1 direct UDP metadata row count=${line_count}, want 1..256"
		return 1
	fi
	offending=$(awk -v source="${source_endpoint}" -v reverse="${reverse_endpoint}" '
		NF && !(($2 == "IP" && $3 == source && $4 == ">" && $5 == reverse ":") ||
			($2 == "IP" && $3 == reverse && $4 == ">" && $5 == source ":")) {print; exit}
	' "${udp_event_files[0]}")
	if [[ -n ${offending} ]]; then
		mpudp_it_die "T1 observed a non-direct or unstable UDP tuple: ${offending}"
		return 1
	fi
	for index in 1 2 3 4; do
		if grep -q '[^[:space:]]' "${udp_event_files[${index}]}"; then
			mpudp_it_die "T$((index + 1)) unexpectedly observed direct single-Carrier traffic"
			return 1
		fi
	done
}

assert_peer_event_once() {
	local file=$1 event_name=$2 phase=$3 bytes=$4 expected_digest=$5 description=$6 marker count
	marker="\"event\":\"${event_name}\",\"phase\":\"${phase}\",\"bytes\":${bytes},\"sha256_prefix\":\"${expected_digest}\""
	count=$(awk -v marker="${marker}" 'index($0, marker) {count++} END {print count+0}' "${file}")
	if [[ ${count} != 1 ]]; then
		mpudp_it_die "${description} metadata count=${count}, want 1"
		return 1
	fi
}

assert_peer_event_order() {
	local file=$1 previous=0 marker line
	shift
	for marker in "$@"; do
		line=$(awk -v marker="${marker}" 'index($0, marker) {count++; found=NR} END {if (count == 1) print found; else print 0}' "${file}")
		if (( line <= previous )); then
			mpudp_it_die "public Peer event order is invalid around ${marker}"
			return 1
		fi
		previous=${line}
	done
}

run_direct_single_carrier() {
	local family=$1 t_ns alice_address bob_address target dnat_before dnat_after snat_before snat_after
	local before_tuple after_tuple socket_difference direct_source
	local -a udp_pids=() udp_event_files=() udp_log_files=()
	if [[ ${family} != 4 ]]; then
		mpudp_it_die "direct-single-carrier currently has an explicit IPv4 contract"
		return 2
	fi
	t_ns=$(mpudp_it_ns t1)
	alice_address=$(mpudp_it_alice_addr 4 1)
	bob_address=$(mpudp_it_bob_addr 4 1)
	target=${bob_address}:9000
	dnat_before=$(counter_for_rule_fragments "${t_ns}" ip "${MPUDP_IT_TABLE4}" prerouting \
		"ip daddr $(mpudp_it_t_ingress_addr 4 1) udp dport 4000" "dnat to ${bob_address}:9000")
	snat_before=$(counter_for_rule_fragments "${t_ns}" ip "${MPUDP_IT_TABLE4}" postrouting \
		"ip daddr ${bob_address} udp dport 9000" masquerade)
	if [[ ! ${dnat_before} =~ ^[0-9]+$ || ! ${snat_before} =~ ^[0-9]+$ ]]; then
		mpudp_it_die "T1 baseline NAT counters are unavailable"
		return 1
	fi
	trap cleanup_direct_single_carrier RETURN
	configure_direct_single_carrier
	start_udp_observers 4 both direct
	start_peer_exchange 4 direct-single-carrier 1200 1200 321 257 0 false false "${target}"
	capture_single_direct_carrier before
	before_tuple=${direct_tuple_file}
	direct_source=${direct_source_port}
	release_peer_exchange
	capture_single_direct_carrier after
	after_tuple=${direct_tuple_file}
	socket_difference=${MPUDP_IT_STATE_DIR}/${case_name}-socket-difference.log
	if ! diff -u "${before_tuple}" "${after_tuple}" >"${socket_difference}"; then
		mpudp_it_die "Alice's OS-assigned direct Carrier tuple changed during the exchange"
		return 1
	fi
	if [[ ${direct_source_port} != "${direct_source}" ]]; then
		mpudp_it_die "Alice's direct Carrier source port changed during the exchange"
		return 1
	fi
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "one or more direct UDP metadata observers exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_direct_wire_metadata "${direct_source}"
	assert_counter_at_least "${t_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-direct-no-snat 1
	assert_counter_at_least "${t_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-direct-forward 1
	assert_counter_at_least "${t_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-direct-reverse 1
	dnat_after=$(counter_for_rule_fragments "${t_ns}" ip "${MPUDP_IT_TABLE4}" prerouting \
		"ip daddr $(mpudp_it_t_ingress_addr 4 1) udp dport 4000" "dnat to ${bob_address}:9000")
	snat_after=$(counter_for_rule_fragments "${t_ns}" ip "${MPUDP_IT_TABLE4}" postrouting \
		"ip daddr ${bob_address} udp dport 9000" masquerade)
	if [[ ${dnat_after} != "${dnat_before}" || ${snat_after} != "${snat_before}" ]]; then
		mpudp_it_die "direct traffic changed baseline DNAT/SNAT counters"
		return 1
	fi
	assert_peer_event_once "${peer_initiator_events}" datagram_sent main 321 e91ff40e5f79 "Alice main send"
	assert_peer_event_once "${peer_listener_events}" datagram_received main 321 e91ff40e5f79 "Bob main delivery"
	assert_peer_event_once "${peer_initiator_events}" datagram_sent empty 0 e3b0c44298fc "Alice empty send"
	assert_peer_event_once "${peer_listener_events}" datagram_received empty 0 e3b0c44298fc "Bob empty delivery"
	assert_peer_event_once "${peer_listener_events}" datagram_sent main 257 83c99b15dfcd "Bob main send"
	assert_peer_event_once "${peer_initiator_events}" datagram_received main 257 83c99b15dfcd "Alice main delivery"
	assert_peer_event_once "${peer_listener_events}" datagram_sent empty 0 e3b0c44298fc "Bob empty send"
	assert_peer_event_once "${peer_initiator_events}" datagram_received empty 0 e3b0c44298fc "Alice empty delivery"
	assert_peer_event_order "${peer_initiator_events}" \
		'"event":"datagram_sent","phase":"main"' '"event":"datagram_sent","phase":"empty"' \
		'"event":"datagram_received","phase":"main"' '"event":"datagram_received","phase":"empty"' \
		'"event":"session_closed"' '"event":"flow_complete"' '"event":"peer_closed"'
	assert_peer_event_order "${peer_listener_events}" \
		'"event":"datagram_received","phase":"main"' '"event":"datagram_received","phase":"empty"' \
		'"event":"datagram_sent","phase":"main"' '"event":"datagram_sent","phase":"empty"' \
		'"event":"session_closed"' '"event":"flow_complete"' '"event":"peer_closed"'
	if [[ $(awk 'END {print NR+0}' "${peer_listener_events}") -gt 32 ||
		$(awk 'END {print NR+0}' "${peer_initiator_events}") -gt 32 ]]; then
		mpudp_it_die "direct public Peer diagnostic event count exceeded 32"
		return 1
	fi
	cleanup_direct_single_carrier
	trap - RETURN
	mpudp_it_log "case passed: ${case_name} (direct IPv4, one stable OS-assigned Carrier, exact non-empty/empty Datagram boundaries)"
}

assert_transit_namespaces_idle() {
	local path namespace
	for path in 1 2 3 4 5; do
		namespace=$(mpudp_it_ns "t${path}")
		if [[ -n $(ip netns pids "${namespace}") ]]; then
			mpudp_it_die "T${path} runs a process; transparent forwarding must use only kernel nftables/conntrack"
			return 1
		fi
	done
}

assert_event_count() {
	local file=$1 event_name=$2 phase=$3 bytes=$4 expected=$5 description=$6 marker count
	marker="\"event\":\"${event_name}\",\"phase\":\"${phase}\",\"bytes\":${bytes}"
	count=$(awk -v marker="${marker}" 'index($0, marker) {count++} END {print count+0}' "${file}")
	if [[ ${count} != "${expected}" ]]; then
		mpudp_it_die "${description} event count=${count}, want ${expected}"
		return 1
	fi
}

run_transparent_nat_reverse_path() {
	local family=$1 path alice_ns bob_ns bob_address alice_address table nft_family
	local forward_bytes=1541 reply_bytes=887 forward_wire=585 reverse_wire=367
	local -a fragment_pids=() fragment_event_files=() fragment_log_files=()
	local -a udp_pids=() udp_event_files=() udp_log_files=()
	local -a path_counter_snapshot=() forward_before=() reverse_before=()
	local -a forward_data_before=() reverse_data_before=()
	if [[ ${family} != 4 ]]; then
		mpudp_it_die "transparent-nat-reverse-path currently has an explicit IPv4 contract"
		return 2
	fi
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	table=${MPUDP_IT_TABLE4}
	nft_family=ip
	assert_transit_namespaces_idle
	for path in 1 2 3 4 5; do
		bob_address=$(mpudp_it_bob_addr 4 "${path}")
		alice_address=$(mpudp_it_alice_addr 4 "${path}")
		if ip -n "${alice_ns}" -4 route get "${bob_address}" >/dev/null 2>&1; then
			mpudp_it_die "Alice unexpectedly has a route to Bob path ${path}; the Carrier must target T${path}"
			return 1
		fi
		if ip -n "${bob_ns}" -4 route get "${alice_address}" >/dev/null 2>&1; then
			mpudp_it_die "Bob unexpectedly has a route to Alice path ${path}; reverse traffic must use conntrack"
			return 1
		fi
	done

	start_fragment_observers 4 canonical-nat
	start_udp_observers 4 both canonical-nat
	snapshot_path_counters 4 mpudp-forward
	forward_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters 4 mpudp-reverse
	reverse_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters 4 mpudp-forward-data
	forward_data_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters 4 mpudp-reverse-data
	reverse_data_before=("${path_counter_snapshot[@]}")

	start_peer_exchange 4 transparent-nat-reverse-path 1200 1200 \
		"${forward_bytes}" "${reply_bytes}" 0 false false
	assert_five_carrier_sockets 4 canonical-nat
	release_peer_exchange
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "one or more canonical NAT UDP observers exited unexpectedly"; return 1; }
	stop_fragment_observers || { mpudp_it_die "one or more canonical NAT fragment observers exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_udp_length_all_paths_direction "${forward_wire}" forward
	assert_udp_length_all_paths_direction "${reverse_wire}" reverse
	assert_no_wire_fragments
	assert_transit_namespaces_idle

	for path in 1 2 3 4 5; do
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-forward "${forward_before[$((path - 1))]}"
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-reverse "${reverse_before[$((path - 1))]}"
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-forward-data "${forward_data_before[$((path - 1))]}"
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-reverse-data "${reverse_data_before[$((path - 1))]}"
	done
	assert_event_count "${peer_listener_events}" datagram_received main "${forward_bytes}" 1 \
		"Bob canonical NAT delivery"
	assert_event_count "${peer_initiator_events}" datagram_received main "${reply_bytes}" 1 \
		"Alice canonical NAT reverse delivery"
	mpudp_it_log "case passed: ${case_name} (five kernel-only DNAT/SNAT paths and listener-port conntrack replies)"
}

assert_reverse_endpoint_length() {
	local expected=$1 port=$2 mode=$3 pattern
	pattern="\\.9000 > [^ ]+\\.${port}: UDP, length ${expected}$"
	if [[ ${mode} == present ]]; then
		if ! grep -Eq "${pattern}" "${udp_event_files[0]}"; then
			mpudp_it_die "T1 did not observe reverse UDP length ${expected} to NAT port ${port}"
			return 1
		fi
	elif grep -Eq "${pattern}" "${udp_event_files[0]}"; then
		mpudp_it_die "T1 observed post-expiry UDP length ${expected} to expired NAT port ${port}"
		return 1
	fi
}

run_endpoint_rebinding_and_expiry() {
	local family=$1 path t1_ns old_drop_before old_drop_after wait_started expired elapsed accepted_count
	local -a fragment_pids=() fragment_event_files=() fragment_log_files=()
	local -a udp_pids=() udp_event_files=() udp_log_files=()
	if [[ ${family} != 4 ]]; then
		mpudp_it_die "endpoint-rebinding-and-expiry currently has an explicit IPv4 contract"
		return 2
	fi
	t1_ns=$(mpudp_it_ns t1)
	canonical_rebinding_mutation_file=${MPUDP_IT_STATE_DIR}/endpoint-rebinding-and-expiry.mutations
	: >"${canonical_rebinding_mutation_file}"
	trap cleanup_canonical_rebinding RETURN

	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" nat-rebind \
		--path 1 --family 4 --zone 101 --source-port 41001
	start_fragment_observers 4 canonical-rebinding
	start_udp_observers 4 both canonical-rebinding
	start_peer_exchange 4 endpoint-rebinding-and-expiry 1200 1200 2049 1027 0 false true "" 5s 1s 6s
	wait_for_udp_source_port 1 41001
	assert_five_carrier_sockets 4 before-canonical-rebind

	ip netns exec "${t1_ns}" nft insert rule ip "${MPUDP_IT_TABLE4}" forward \
		iifname out4 ct zone 101 udp sport 9000 counter drop comment mpudp-expired-endpoint-drop
	old_drop_before=$(counter_for_comment "${t1_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-expired-endpoint-drop)
	"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" nat-rebind \
		--path 1 --family 4 --zone 102 --source-port 41002
	for path in 2 3; do
		"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" netem \
			--path "${path}" --family 4 --direction forward --loss 100%
	done

	release_peer_exchange
	wait_for_udp_source_port 1 41002
	finish_peer_exchange
	stop_udp_observers || { mpudp_it_die "one or more canonical rebinding UDP observers exited unexpectedly"; return 1; }
	stop_fragment_observers || { mpudp_it_die "one or more canonical rebinding fragment observers exited unexpectedly"; return 1; }
	assert_udp_observation_lossless
	assert_no_wire_fragments
	assert_udp_lengths_at_most 1200
	assert_udp_length_paths_direction 754 forward 1 4 5
	assert_udp_length_absent_direction 754 forward 2
	assert_udp_length_absent_direction 754 forward 3
	assert_udp_length_paths_direction 182 reverse 1 4 5
	assert_udp_length_absent_direction 182 reverse 2
	assert_udp_length_absent_direction 182 reverse 3
	assert_reverse_endpoint_length 182 41002 present
	assert_reverse_endpoint_length 182 41001 absent

	old_drop_after=$(counter_for_comment "${t1_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-expired-endpoint-drop)
	if [[ ! ${old_drop_before} =~ ^[0-9]+$ || ! ${old_drop_after} =~ ^[0-9]+$ ]] ||
		(( old_drop_after <= old_drop_before )); then
		mpudp_it_die "the old Endpoint did not fail on the isolated zone-101 reverse path"
		return 1
	fi
	assert_counter_at_least "${t1_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-rebind-snat-101-41001 1
	assert_counter_at_least "${t1_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-rebind-snat-102-41002 1
	assert_counter_at_least "${t1_ns}" ip "${MPUDP_IT_TABLE4}" mpudp-rebind-reverse-102-41002 1
	accepted_count=$(grep -c '"event":"session_accepted"' "${peer_listener_events}" || true)
	if [[ ${accepted_count} != 1 ]] ||
		! grep -q '"event":"single_session_retained","phase":"main"' "${peer_listener_events}"; then
		mpudp_it_die "rebinding did not retain exactly one accepted Session"
		return 1
	fi
	wait_started=$(sed -n 's/.*"event":"expiry_wait_started".*"elapsed_ms":\([0-9][0-9]*\).*/\1/p' \
		"${peer_listener_events}" | sed -n '1p')
	expired=$(sed -n 's/.*"event":"endpoint_expiry_verified".*"elapsed_ms":\([0-9][0-9]*\).*/\1/p' \
		"${peer_listener_events}" | sed -n '1p')
	if [[ ! ${wait_started} =~ ^[0-9]+$ || ! ${expired} =~ ^[0-9]+$ ]]; then
		mpudp_it_die "rebinding expiry timing metadata is missing"
		return 1
	fi
	elapsed=$((expired - wait_started))
	if (( elapsed < 5000 )); then
		mpudp_it_die "old Endpoint expiry proof completed after only ${elapsed}ms"
		return 1
	fi
	assert_event_count "${peer_listener_events}" datagram_received main 2049 1 \
		"Bob rebound-path delivery"
	assert_event_count "${peer_initiator_events}" datagram_received post-expiry 333 1 \
		"Alice post-expiry delivery"

	cleanup_canonical_rebinding
	trap - RETURN
	mpudp_it_log "case passed: ${case_name} (41001 failed, 41002 joined, old Endpoint expired after ${elapsed}ms, same Session survived)"
}

