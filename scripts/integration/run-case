		network=udp4; listen_address=0.0.0.0:9000
	else
		network=udp6; listen_address='[::]:9000'
	fi
	target=$(mpudp_it_target "${family}" 1)
	server_events=${MPUDP_IT_STATE_DIR}/${case_name}-server.ndjson
	client_events=${MPUDP_IT_STATE_DIR}/${case_name}-client.ndjson
	ready_file=${MPUDP_IT_STATE_DIR}/${case_name}.ready
	server_log=${MPUDP_IT_STATE_DIR}/${case_name}-server.log
	client_log=${MPUDP_IT_STATE_DIR}/${case_name}-client.log
	: >"${server_events}"; : >"${client_events}"; : >"${server_log}"; : >"${client_log}"
	rm -f -- "${ready_file}"

	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${bob_ns}" "${netprobe}" \
		--mode server --network "${network}" --listen "${listen_address}" --count 2 \
		--require-unique-remotes --timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" \
		--events "${server_events}" --ready-file "${ready_file}" >"${server_log}" 2>&1 &
	server_pid=$!
	mpudp_it_record_pid "${server_pid}"
	if ! wait_ready "${ready_file}" "${server_pid}"; then
		mpudp_it_die "Bob rebinding netprobe did not become ready"
		return 1
	fi
	for source_port in 41001 41002; do
		if ! timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
			ip netns exec "${alice_ns}" "${netprobe}" \
			--mode client --network "${network}" --targets "${target}" --local-port-base "${source_port}" \
			--timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}" --events "${client_events}" \
			>>"${client_log}" 2>&1; then
			mpudp_it_die "Alice rebinding client failed at source port ${source_port}"
			return 1
		fi
	done
	set +e
	wait "${server_pid}"
	server_status=$?
	set -e
	if (( server_status != 0 )); then
		mpudp_it_die "Bob did not observe two distinct NAT endpoints; see ${server_log}"
		return 1
	fi
	if [[ $(awk 'END {print NR}' "${server_events}") != 2 || $(awk 'END {print NR}' "${client_events}") != 2 ]]; then
		mpudp_it_die "rebinding event count is not 2 server + 2 client"
		return 1
	fi
	sed -n 'p' "${server_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	sed -n 'p' "${client_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	mpudp_it_log "case passed: ${case_name} (source ports 41001 -> 41002 produced distinct NAT endpoints)"
}

run_rs_scenario() {
	local events_file log_file ready_file continue_file rsprobe_pid rsprobe_status
	local complete_count primary_count boundary_count
	build_rsprobe
	events_file=${MPUDP_IT_STATE_DIR}/${case_name}-events.ndjson
	log_file=${MPUDP_IT_STATE_DIR}/${case_name}.log
	ready_file=${MPUDP_IT_STATE_DIR}/${case_name}.ready
	continue_file=${MPUDP_IT_STATE_DIR}/${case_name}.continue
	: >"${events_file}"
	: >"${log_file}"
	rm -f -- "${ready_file}" "${continue_file}"
	"${rsprobe}" --scenario "${case_name}" --run-id "${MPUDP_IT_RUN_ID}" \
		--timeout "${case_timeout}s" --events "${events_file}" \
		--ready-file "${ready_file}" --continue-file "${continue_file}" >"${log_file}" 2>&1 &
	rsprobe_pid=$!
	if ! mpudp_it_record_pid "${rsprobe_pid}"; then
		kill -TERM "${rsprobe_pid}" 2>/dev/null || true
		wait "${rsprobe_pid}" 2>/dev/null || true
		return 1
	fi
	if ! wait_ready "${ready_file}" "${rsprobe_pid}"; then
		mpudp_it_die "${case_name} deterministic Session probe did not become ready; see ${log_file}"
		return 1
	fi
	printf 'continue\n' >"${continue_file}"
	set +e
	wait "${rsprobe_pid}"
	rsprobe_status=$?
	set -e
	if (( rsprobe_status != 0 )); then
		mpudp_it_die "${case_name} deterministic Session probe failed; see ${log_file}"
		return 1
	fi
	complete_count=$(grep -c '"event":"scenario_complete"' "${events_file}" || true)
	if [[ ${complete_count} != 1 ]]; then
		mpudp_it_die "${case_name} completion event count=${complete_count}, want 1"
		return 1
	fi
	case ${case_name} in
		rs53-five-carrier-loss)
			primary_count=$(grep -c '"event":"two_loss_recovered"' "${events_file}" || true)
			boundary_count=$(grep -c '"event":"three_loss_expired"' "${events_file}" || true)
			if [[ ${primary_count} != 10 || ${boundary_count} != 1 ]]; then
				mpudp_it_die "five-Carrier evidence counts=${primary_count}/${boundary_count}, want 10/1"
				return 1
			fi
			;;
		rs53-two-carrier-rotation)
			primary_count=$(grep -c '"event":"rotation_observed"' "${events_file}" || true)
			boundary_count=$(grep -Ec '"event":"(two_shard_carrier_lost_recovered|three_shard_carrier_lost_expired|post_loss_session_recovered)"' "${events_file}" || true)
			if [[ ${primary_count} != 4 || ${boundary_count} != 3 ]]; then
				mpudp_it_die "two-Carrier evidence counts=${primary_count}/${boundary_count}, want 4/3"
				return 1
			fi
			;;
		slow-path-early-recovery)
			primary_count=$(grep -c '"event":"shard_arrived"' "${events_file}" || true)
			boundary_count=$(grep -c '"event":"datagram_recovered"' "${events_file}" || true)
			if [[ ${primary_count} != 4 || ${boundary_count} != 1 ]]; then
				mpudp_it_die "slow-path evidence counts=${primary_count}/${boundary_count}, want 4/1"
				return 1
			fi
			;;
		*)
			mpudp_it_die "unsupported deterministic RS scenario ${case_name}"
			return 2
			;;
	esac
	if grep -Eiq '"(payload|session_id|authentication_tag|psk)"' "${events_file}"; then
		mpudp_it_die "${case_name} event metadata contains a forbidden sensitive field"
		return 1
	fi
	sed -n 'p' "${events_file}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	mpudp_it_log "case passed: ${case_name} (deterministic authenticated Session/FEC invariants)"
}

assert_counter_delta_at_least() {
	local namespace=$1 nft_family=$2 table=$3 comment=$4 baseline=$5 minimum_delta=$6 value delta
	value=$(counter_for_comment "${namespace}" "${nft_family}" "${table}" "${comment}")
	if [[ ! ${value} =~ ^[0-9]+$ ]]; then
		mpudp_it_die "${namespace} ${comment} counter is missing"
		return 1
	fi
	delta=$((value - baseline))
	if (( delta < minimum_delta )); then
		mpudp_it_die "${namespace} ${comment} delta=${delta}, want >=${minimum_delta}"
		return 1
	fi
}

run_peer_auth_pollution() {
	local family=$1 alice_ns bob_ns listen_address target targets table nft_family path kind
	local listener_events attacker_events client_events listener_log attacker_log client_log
	local ready_file attack_done_file checked_file reply_complete_file exit_file final_file
	local listener_pid client_pid listener_status client_status
	local -a path_counter_snapshot=() forward_before=() reverse_before=() legit_forward_before=() legit_reverse_before=()
	build_pollutionprobe
	build_peerprobe
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	listen_address=0.0.0.0:9000
	if [[ ${family} == 6 ]]; then listen_address='[::]:9000'; fi
	target=$(mpudp_it_target "${family}" 1)
	table=${MPUDP_IT_TABLE4}; nft_family=ip
	if [[ ${family} == 6 ]]; then table=${MPUDP_IT_TABLE6}; nft_family=ip6; fi
	listener_events=${MPUDP_IT_STATE_DIR}/${case_name}-listener.ndjson
	attacker_events=${MPUDP_IT_STATE_DIR}/${case_name}-attacker.ndjson
	client_events=${MPUDP_IT_STATE_DIR}/${case_name}-legitimate.ndjson
	listener_log=${MPUDP_IT_STATE_DIR}/${case_name}-listener.log
	attacker_log=${MPUDP_IT_STATE_DIR}/${case_name}-attacker.log
	client_log=${MPUDP_IT_STATE_DIR}/${case_name}-legitimate.log
	ready_file=${MPUDP_IT_STATE_DIR}/${case_name}.ready
	attack_done_file=${MPUDP_IT_STATE_DIR}/${case_name}.attack-done
	checked_file=${MPUDP_IT_STATE_DIR}/${case_name}.checked
	reply_complete_file=${MPUDP_IT_STATE_DIR}/${case_name}.reply-complete
	exit_file=${MPUDP_IT_STATE_DIR}/${case_name}.exit
	final_file=${MPUDP_IT_STATE_DIR}/${case_name}.final
	rm -f -- "${ready_file}" "${attack_done_file}" "${checked_file}" "${reply_complete_file}" "${exit_file}" "${final_file}"
	: >"${listener_log}"
	: >"${attacker_log}"
	: >"${client_log}"

	snapshot_path_counters "${family}" mpudp-forward
	forward_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters "${family}" mpudp-reverse
	reverse_before=("${path_counter_snapshot[@]}")
	ip netns exec "${bob_ns}" "${pollutionprobe}" \
		--role listener --family "${family}" --listen "${listen_address}" --max-udp-payload 1200 \
		--high-sources 128 --body-bytes 512 --reply-bytes 257 --timeout "${case_timeout}s" \
		--run-id "${MPUDP_IT_RUN_ID}" --events "${listener_events}" --ready-file "${ready_file}" \
		--attack-done-file "${attack_done_file}" --checked-file "${checked_file}" \
		--reply-complete-file "${reply_complete_file}" --exit-file "${exit_file}" --final-file "${final_file}" \
		>"${listener_log}" 2>&1 &
	listener_pid=$!
	mpudp_it_record_pid "${listener_pid}"
	if ! wait_ready "${ready_file}" "${listener_pid}"; then
		mpudp_it_die "pollution listener did not become ready; see ${listener_log}"
		return 1
	fi

	if ! timeout --signal=TERM --kill-after=2s 12s \
		ip netns exec "${alice_ns}" "${pollutionprobe}" \
			--role attacker --family "${family}" --target "${target}" --max-udp-payload 1200 \
			--high-sources 128 --timeout 10s --run-id "${MPUDP_IT_RUN_ID}" --events "${attacker_events}" \
			>"${attacker_log}" 2>&1; then
		mpudp_it_die "pollution attack probe failed; see ${attacker_log}"
		return 1
	fi
	assert_counter_delta_at_least "$(mpudp_it_ns t1)" "${nft_family}" "${table}" mpudp-forward "${forward_before[0]}" 134
	assert_counter_equal "$(mpudp_it_ns t1)" "${nft_family}" "${table}" mpudp-reverse "$((reverse_before[0] + 1))"
	for path in 2 3 4 5; do
		assert_counter_equal "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-forward "${forward_before[$((path - 1))]}"
		assert_counter_equal "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-reverse "${reverse_before[$((path - 1))]}"
	done
	grep -q '"event":"processing_barrier_complete".*"responses":1' "${attacker_events}" || {
		mpudp_it_die "authenticated processing barrier response is missing"
		return 1
	}
	printf 'done\n' >"${attack_done_file}"
	if ! wait_ready "${checked_file}" "${listener_pid}"; then
		mpudp_it_die "listener did not prove clean state after attacks; see ${listener_log}"
		return 1
	fi
	grep -q '"event":"processing_barrier_drained".*"sessions":0' "${listener_events}" || {
		mpudp_it_die "listener did not drain the authenticated processing barrier"
		return 1
	}
	for kind in wrong-psk single-bit-tamper forged-session-id malformed oversized; do
		grep -q "\"event\":\"attack_class_complete\".*\"packets\":1.*\"phase\":\"${kind}\".*\"responses\":0" \
			"${attacker_events}" || { mpudp_it_die "missing zero-response evidence for ${kind}"; return 1; }
	done
	grep -q '"event":"attack_class_complete".*"packets":128.*"phase":"high-cardinality".*"responses":0' \
		"${attacker_events}" || { mpudp_it_die "missing high-cardinality zero-response evidence"; return 1; }
	grep -q '"event":"attack_batch_complete".*"packets":133.*"responses":0.*"unique_sources":133' \
		"${attacker_events}" || { mpudp_it_die "attack batch did not retain 133 unique zero-response sources"; return 1; }
	grep -q '"event":"pollution_state_clean".*"sessions":0' "${listener_events}" || {
		mpudp_it_die "listener did not record bounded zero-Session state"
		return 1
	}

	snapshot_path_counters "${family}" mpudp-forward-data
	legit_forward_before=("${path_counter_snapshot[@]}")
	snapshot_path_counters "${family}" mpudp-reverse-data
	legit_reverse_before=("${path_counter_snapshot[@]}")
	targets=$(mpudp_it_join_targets "${family}")
	timeout --signal=TERM --kill-after=2s "${case_timeout}s" \
		ip netns exec "${alice_ns}" "${peerprobe}" \
			--role initiator --flow pollution-live --family "${family}" --carriers "${targets}" \
			--max-udp-payload 1200 --body-bytes 512 --reply-bytes 257 --timeout "${case_timeout}s" \
			--run-id "${MPUDP_IT_RUN_ID}" --events "${client_events}" \
			--reply-complete-file "${reply_complete_file}" --exit-file "${exit_file}" --final-file "${final_file}" \
			>"${client_log}" 2>&1 &
	client_pid=$!
	mpudp_it_record_pid "${client_pid}"
	if ! wait_ready "${exit_file}" "${client_pid}"; then
		mpudp_it_die "legitimate client did not complete after pollution; see ${client_log}"
		return 1
	fi
	printf 'finish\n' >"${final_file}"
	set +e
	wait "${client_pid}"
	client_status=$?
	if (( client_status != 0 )) && kill -0 "${listener_pid}" 2>/dev/null; then kill -TERM "${listener_pid}" 2>/dev/null || true; fi
	wait "${listener_pid}"
	listener_status=$?
	set -e
	if (( client_status != 0 || listener_status != 0 )); then
		mpudp_it_die "post-pollution liveness process failure: client=${client_status} listener=${listener_status}; see ${client_log} and ${listener_log}"
		return 1
	fi
	grep -q '"event":"legitimate_exchange_complete".*"received_bytes":512.*"reply_bytes":257' "${listener_events}" || {
		mpudp_it_die "attacked listener did not complete the legitimate exchange"
		return 1
	}
	grep -q '"event":"datagram_received","phase":"main","bytes":257' "${client_events}" || {
		mpudp_it_die "legitimate client did not receive the post-attack reply"
		return 1
	}
	for path in 1 2 3 4 5; do
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-forward-data "${legit_forward_before[$((path - 1))]}"
		assert_counter_greater_than "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" \
			mpudp-reverse-data "${legit_reverse_before[$((path - 1))]}"
	done
	if grep -Fqi 'integration-test-key' "${listener_events}" "${attacker_events}" "${client_events}" ||
		grep -Eqi '"(payload|psk|authentication[_-]?tag|hmac|session_id)"[[:space:]]*:' \
			"${listener_events}" "${attacker_events}" "${client_events}"; then
		mpudp_it_die "pollution diagnostics contain a forbidden sensitive field"
		return 1
	fi
	sed -n 'p' "${listener_events}" "${attacker_events}" "${client_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	mpudp_it_log "case passed: ${case_name} (six attack classes retained no state or responses; attacked Peer remained live)"
}

sum_path_counters() {
	local family=$1 comment=$2 table nft_family path value total=0
	table=${MPUDP_IT_TABLE4}; nft_family=ip
	if [[ ${family} == 6 ]]; then table=${MPUDP_IT_TABLE6}; nft_family=ip6; fi
	for path in 1 2 3 4 5; do
		value=$(counter_for_comment "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" "${comment}")
		if [[ ! ${value} =~ ^[0-9]+$ ]]; then
			mpudp_it_die "T${path} ${comment} counter is missing"
			return 1
		fi
		total=$((total + value))
	done
	printf '%s\n' "${total}"
}

assert_no_netem() {
	local family=$1 path alice_ns bob_ns alice_if bob_if
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	for path in 1 2 3 4 5; do
		alice_if=$(mpudp_it_alice_if "${family}" "${path}")
		bob_if=$(mpudp_it_bob_if "${family}" "${path}")
		if ip netns exec "${alice_ns}" tc qdisc show dev "${alice_if}" | grep ' netem ' >/dev/null ||
			ip netns exec "${bob_ns}" tc qdisc show dev "${bob_if}" | grep ' netem ' >/dev/null; then
			mpudp_it_die "netem residue remains on path ${path}"
			return 1
		fi
	done
}

apply_shutdown_netem() {
	local family=$1 direction=$2 kind=$3 value=$4 path
	for path in 1 2 3 4 5; do
		"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" netem --path "${path}" --family "${family}" \
			--direction "${direction}" "--${kind}" "${value}"
	done
}

clear_shutdown_netem() {
	local family=$1 direction=$2 path
	for path in 1 2 3 4 5; do
		"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-netem --path "${path}" --family "${family}" \
			--direction "${direction}"
	done
	assert_no_netem "${family}"
}

shutdown_forward_netem_total() {
	local family=$1 metric=$2 path namespace interface value total=0
	namespace=$(mpudp_it_ns alice)
	for path in 1 2 3 4 5; do
		interface=$(mpudp_it_alice_if "${family}" "${path}")
		case ${metric} in
			backlog)
				value=$(ip netns exec "${namespace}" tc -s qdisc show dev "${interface}" |
					awk '$1 == "backlog" {value=$3; sub(/p$/, "", value); print value; exit}')
				;;
			dropped)
				value=$(ip netns exec "${namespace}" tc -s qdisc show dev "${interface}" |
					awk '/ Sent / {for (i=1; i<=NF; i++) if ($i == "(dropped") {value=$(i+1); sub(/,$/, "", value); print value; exit}}')
				;;
			*) mpudp_it_die "unknown shutdown netem metric ${metric}"; return 2 ;;
		esac
		if [[ ! ${value} =~ ^[0-9]+$ ]]; then
			mpudp_it_die "path ${path} shutdown netem ${metric} is unavailable"
			return 1
		fi
		total=$((total + value))
	done
	printf '%s\n' "${total}"
}

wait_shutdown_netem_total() {
	local family=$1 metric=$2 minimum=$3 attempt total
	for attempt in $(seq 1 100); do
		total=$(shutdown_forward_netem_total "${family}" "${metric}") || return 1
		if (( total >= minimum )); then return 0; fi
		sleep 0.02
	done
	mpudp_it_die "shutdown forward netem ${metric}=${total}, want >=${minimum}"
	return 1
}

record_shutdown_fault() {
	local event_name=$1 phase=$2 fault=$3
	printf '{"event":"%s","fault":"%s","phase":"%s","run_id":"%s"}\n' \
		"${event_name}" "${fault}" "${phase}" "${MPUDP_IT_RUN_ID}" >>"${shutdown_fault_events}"
}

start_shutdown_pair() {
	local phase=$1 action=$2 family=$3 alice_ns bob_ns listen_address targets table nft_family path attempt all_ready current
	local -a listener_args initiator_args path_counter_snapshot=() ack_before=()
	alice_ns=$(mpudp_it_ns alice)
	bob_ns=$(mpudp_it_ns bob)
	listen_address=0.0.0.0:9000
	if [[ ${family} == 6 ]]; then listen_address='[::]:9000'; fi
	targets=$(mpudp_it_join_targets "${family}")
	table=${MPUDP_IT_TABLE4}; nft_family=ip
	if [[ ${family} == 6 ]]; then table=${MPUDP_IT_TABLE6}; nft_family=ip6; fi
	if [[ ${phase} != handshake ]]; then
		snapshot_path_counters "${family}" mpudp-reverse-control
		ack_before=("${path_counter_snapshot[@]}")
	fi
	shutdown_listener_events=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}-bob.ndjson
	shutdown_initiator_events=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}-alice.ndjson
	shutdown_listener_log=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}-bob.log
	shutdown_initiator_log=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}-alice.log
	shutdown_ready_file=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.ready
	shutdown_listener_phase=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.bob-phase
	shutdown_initiator_phase=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.alice-phase
	shutdown_bootstrap_file=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.bootstrap
	shutdown_send_file=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.send
	shutdown_sent_file=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.sent
	shutdown_close_file=${MPUDP_IT_STATE_DIR}/${case_name}-${phase}.close
	rm -f -- "${shutdown_ready_file}" "${shutdown_listener_phase}" "${shutdown_initiator_phase}" \
		"${shutdown_bootstrap_file}" "${shutdown_send_file}" "${shutdown_sent_file}" "${shutdown_close_file}"
	: >"${shutdown_listener_log}"
	: >"${shutdown_initiator_log}"
	listener_args=(
		--role listener --phase "${phase}" --action "${action}" --family "${family}" --listen "${listen_address}"
		--body-bytes 1536 --timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}"
		--events "${shutdown_listener_events}" --ready-file "${shutdown_ready_file}"
		--phase-ready-file "${shutdown_listener_phase}"
	)
	initiator_args=(
		--role initiator --phase "${phase}" --action "${action}" --family "${family}" --carriers "${targets}"
		--body-bytes 1536 --timeout "${case_timeout}s" --run-id "${MPUDP_IT_RUN_ID}"
		--events "${shutdown_initiator_events}" --phase-ready-file "${shutdown_initiator_phase}"
	)
	if [[ ${action} == close ]]; then
		listener_args+=(--close-file "${shutdown_close_file}")
		initiator_args+=(--close-file "${shutdown_close_file}")
	fi
	if [[ ${phase} == active-transfer || ${phase} == decode-incomplete || ${phase} == network-fault ]]; then
		initiator_args+=(--send-file "${shutdown_send_file}" --sent-file "${shutdown_sent_file}")
	fi
	if [[ ${phase} != handshake ]]; then
		initiator_args+=(--bootstrap-file "${shutdown_bootstrap_file}")
	fi
	ip netns exec "${bob_ns}" "${shutdownprobe}" "${listener_args[@]}" >"${shutdown_listener_log}" 2>&1 &
	shutdown_listener_pid=$!
	mpudp_it_record_pid "${shutdown_listener_pid}"
	if ! wait_ready "${shutdown_ready_file}" "${shutdown_listener_pid}"; then
		mpudp_it_die "${phase} listener did not bind; see ${shutdown_listener_log}"
		return 1
	fi
	if [[ ${phase} == handshake ]]; then
		apply_shutdown_netem "${family}" forward loss 100%
		record_shutdown_fault fault_applied "${phase}" 'forward-loss-100-percent-all-paths'
	fi
	ip netns exec "${alice_ns}" "${shutdownprobe}" "${initiator_args[@]}" >"${shutdown_initiator_log}" 2>&1 &
	shutdown_initiator_pid=$!
	mpudp_it_record_pid "${shutdown_initiator_pid}"
	if [[ ${phase} != handshake ]]; then
		all_ready=0
		for attempt in $(seq 1 100); do
			all_ready=1
			for path in 1 2 3 4 5; do
				current=$(counter_for_comment "$(mpudp_it_ns "t${path}")" "${nft_family}" "${table}" mpudp-reverse-control)
				if [[ ! ${current} =~ ^[0-9]+$ ]] || (( current <= ack_before[$((path - 1))] )); then
					all_ready=0
				fi
			done
			if (( all_ready != 0 )); then break; fi
			if ! kill -0 "${shutdown_initiator_pid}" 2>/dev/null || ! kill -0 "${shutdown_listener_pid}" 2>/dev/null; then break; fi
			sleep 0.05
		done
		if (( all_ready == 0 )); then
			mpudp_it_die "${phase} did not authenticate all five Carriers before bootstrap"
			return 1
		fi
		printf 'bootstrap\n' >"${shutdown_bootstrap_file}"
	fi
	if ! wait_ready "${shutdown_listener_phase}" "${shutdown_listener_pid}" ||
		! wait_ready "${shutdown_initiator_phase}" "${shutdown_initiator_pid}"; then
		mpudp_it_die "${phase} helpers did not reach the requested lifecycle phase; see ${shutdown_listener_log} and ${shutdown_initiator_log}"
		return 1
	fi
}

wait_shutdown_helper() {
	local pid=$1 log=$2 label=$3 attempt status
	for attempt in $(seq 1 60); do
		if ! kill -0 "${pid}" 2>/dev/null; then break; fi
		sleep 0.05
	done
	if kill -0 "${pid}" 2>/dev/null; then
		mpudp_it_die "${label} did not exit within 3 seconds; see ${log}"
		return 1
	fi
	set +e
	wait "${pid}"
	status=$?
	set -e
	if (( status != 0 )); then
		mpudp_it_die "${label} exited ${status}; see ${log}"
		return 1
	fi
}

finish_shutdown_pair() {
	local phase=$1 action=$2 events
	if [[ ${action} == signal ]]; then
		kill -TERM "${shutdown_listener_pid}" "${shutdown_initiator_pid}"
	else
		printf 'close\n' >"${shutdown_close_file}"
	fi
	wait_shutdown_helper "${shutdown_initiator_pid}" "${shutdown_initiator_log}" "${phase} initiator"
	wait_shutdown_helper "${shutdown_listener_pid}" "${shutdown_listener_log}" "${phase} listener"
	for events in "${shutdown_listener_events}" "${shutdown_initiator_events}"; do
		grep -q "\"event\":\"phase_ready\".*\"phase\":\"${phase}\"" "${events}" || {
			mpudp_it_die "${phase} helper did not record phase readiness"
			return 1
		}
		grep -q "\"event\":\"shutdown_trigger\".*\"phase\":\"${phase}\".*\"trigger\":\"${action}\"" "${events}" || {
			mpudp_it_die "${phase} helper did not record ${action} trigger"
			return 1
		}
		grep -q "\"event\":\"peer_close_complete\".*\"phase\":\"${phase}\"" "${events}" || {
			mpudp_it_die "${phase} helper did not complete bounded Peer.Close"
			return 1
		}
	done
	if [[ -e /proc/${shutdown_listener_pid} || -e /proc/${shutdown_initiator_pid} ]]; then
		mpudp_it_die "${phase} left a helper process after bounded shutdown"
		return 1
	fi
	sed -n 'p' "${shutdown_listener_events}" "${shutdown_initiator_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
}

run_peer_shutdown_cleanup() {
	local family=$1 path shard shard_hex baseline expected current stable attempt table nft_family
	build_shutdownprobe
	shutdown_fault_events=${MPUDP_IT_STATE_DIR}/${case_name}-faults.ndjson
	shutdown_mutation_file=${MPUDP_IT_STATE_DIR}/shutdown-cleanup.mutations
	: >"${shutdown_fault_events}"
	table=${MPUDP_IT_TABLE4}; nft_family=ip
	if [[ ${family} == 6 ]]; then table=${MPUDP_IT_TABLE6}; nft_family=ip6; fi

	start_shutdown_pair active-transfer close "${family}"
	: >"${shutdown_mutation_file}"
	apply_shutdown_netem "${family}" forward delay 2s
	record_shutdown_fault fault_applied active-transfer 'forward-delay-2s-all-paths'
	printf 'send\n' >"${shutdown_send_file}"
	if ! wait_ready "${shutdown_sent_file}" "${shutdown_initiator_pid}"; then
		mpudp_it_die "active-transfer initiator did not place the in-flight Datagram"
		return 1
	fi
	wait_shutdown_netem_total "${family}" backlog 5
	record_shutdown_fault fault_observed active-transfer 'forward-backlog-at-least-5-packets'
	finish_shutdown_pair active-transfer close
	clear_shutdown_netem "${family}" forward
	record_shutdown_fault fault_cleared active-transfer 'forward-delay-2s-all-paths'

	start_shutdown_pair decode-incomplete signal "${family}"
	baseline=$(sum_path_counters "${family}" mpudp-forward-data)
	for path in 1 2 3 4 5; do
		for shard in 2 3 4; do
			printf -v shard_hex '%02x' "${shard}"
			"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" drop-match --path "${path}" --family "${family}" \
				--offset 34 --hex "${shard_hex}"
		done
	done
	record_shutdown_fault fault_applied decode-incomplete 'drop-shard-indexes-2-3-4-all-paths'
	printf 'send\n' >"${shutdown_send_file}"
	if ! wait_ready "${shutdown_sent_file}" "${shutdown_initiator_pid}"; then
		mpudp_it_die "decode-incomplete initiator did not send its Datagram"
		return 1
	fi
	expected=$((baseline + 2))
	stable=0
	for attempt in $(seq 1 40); do
		current=$(sum_path_counters "${family}" mpudp-forward-data)
		if (( current > expected )); then
			mpudp_it_die "decode-incomplete delivered $((current - baseline)) shards, want exactly 2"
			return 1
		fi
		if (( current == expected )); then stable=$((stable + 1)); else stable=0; fi
		if (( stable == 3 )); then break; fi
		sleep 0.05
	done
	if (( stable != 3 )); then
		mpudp_it_die "decode-incomplete did not stabilize at exactly 2 delivered shards"
		return 1
	fi
	finish_shutdown_pair decode-incomplete signal
	for path in 1 2 3 4 5; do
		"${SCRIPT_DIR}/control" --state "${MPUDP_IT_STATE_DIR}" clear-drop --path "${path}" --family "${family}"
		if ip netns exec "$(mpudp_it_ns "t${path}")" nft list chain "${nft_family}" "${table}" forward | grep 'mpudp-drop-' >/dev/null; then
			mpudp_it_die "decode-incomplete left a shard drop rule on path ${path}"
			return 1
		fi
	done
	record_shutdown_fault fault_cleared decode-incomplete 'drop-shard-indexes-2-3-4-all-paths'

	start_shutdown_pair network-fault close "${family}"
	apply_shutdown_netem "${family}" both loss 100%
	record_shutdown_fault fault_applied network-fault 'bidirectional-loss-100-percent-all-paths'
	printf 'send\n' >"${shutdown_send_file}"
	if ! wait_ready "${shutdown_sent_file}" "${shutdown_initiator_pid}"; then
		mpudp_it_die "network-fault initiator did not place its Datagram"
		return 1
	fi
	wait_shutdown_netem_total "${family}" dropped 5
	record_shutdown_fault fault_observed network-fault 'forward-drops-at-least-5-packets'
	finish_shutdown_pair network-fault close
	clear_shutdown_netem "${family}" both
	record_shutdown_fault fault_cleared network-fault 'bidirectional-loss-100-percent-all-paths'

	# Run the abandoned handshake last so its live UDP conntrack tuples cannot
	# alias a later fresh process that happens to reuse the same source ports.
	start_shutdown_pair handshake signal "${family}"
	wait_shutdown_netem_total "${family}" dropped 5
	record_shutdown_fault fault_observed handshake 'forward-handshake-drops-at-least-5-packets'
	finish_shutdown_pair handshake signal
	clear_shutdown_netem "${family}" forward
	record_shutdown_fault fault_cleared handshake 'forward-loss-100-percent-all-paths'

	if grep -Fqi 'integration-test-key' "${MPUDP_IT_STATE_DIR}"/${case_name}-*.ndjson ||
		grep -Eqi '"(payload|psk|authentication[_-]?tag|hmac|session_id)"[[:space:]]*:' \
			"${MPUDP_IT_STATE_DIR}"/${case_name}-*.ndjson; then
		mpudp_it_die "shutdown diagnostics contain a forbidden sensitive field"
		return 1
	fi
	cleanup_shutdown_mutations
	sed -n 'p' "${shutdown_fault_events}" >>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	mpudp_it_log "case passed: ${case_name} (four phases completed bounded signal/API shutdown with every fault cleared)"
}

run_case_worker() {
	state_dir=$1
	case_name=$2
	case_timeout=$3
	runner=$4
	family=$5
	mpudp_it_require_root
	mpudp_it_load_state "${state_dir}"
	if [[ ! -f ${MPUDP_IT_STATE_DIR}/ready ]]; then
		mpudp_it_die "topology is not ready"
		return 1
	fi
	printf '{"event":"case_started","run_id":"%s","case":"%s","seed":"%s","runner":"%s","family":"%s","timeout_seconds":%s}\n' \
		"${MPUDP_IT_RUN_ID}" "${case_name}" "${MPUDP_IT_SEED}" "${runner}" "${family}" "${case_timeout}" \
		>>"${MPUDP_IT_STATE_DIR}/events.ndjson"
	case ${runner} in
		raw-nat-smoke) run_raw_nat_smoke "${family}" ;;
		path-controls) run_path_controls "${family}" ;;
		nat-rebinding-trigger) run_nat_rebinding_trigger "${family}" ;;
		direct-single-carrier) run_direct_single_carrier "${family}" ;;
		transparent-nat-reverse-path) run_transparent_nat_reverse_path "${family}" ;;
		endpoint-rebinding-and-expiry) run_endpoint_rebinding_and_expiry "${family}" ;;
		mtu-budget-no-fragment) run_mtu_budget_no_fragment "${family}" ;;
		rs-scenario) run_rs_scenario ;;
		peer-smoke) run_peer_smoke "${family}" ;;
		peer-payload-mtu) run_peer_payload_mtu "${family}" ;;
		peer-nat-rebinding) run_peer_nat_rebinding "${family}" ;;
		peer-endpoint-expiry) run_peer_endpoint_expiry "${family}" ;;
		peer-auth-pollution) run_peer_auth_pollution "${family}" ;;
		peer-shutdown-cleanup) run_peer_shutdown_cleanup "${family}" ;;
		*) mpudp_it_die "unsupported runner ${runner}"; return 2 ;;
	esac
}
