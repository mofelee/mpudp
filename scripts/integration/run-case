#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

manifest=${MPUDP_IT_REPO_ROOT}/integration/scenarios/cases.tsv
state_dir=''
case_name=''
timeout_override=''

usage() {
	printf '%s\n' 'Usage: scripts/integration/run-case --state DIR CASE [--timeout SECONDS]'
	printf '%s\n' '       scripts/integration/run-case --list'
}

if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
	if [[ ${1:-} == --list ]]; then
		awk -F '\t' '!/^#/ && NF {printf "%-34s family=%-4s runtime=%s\n", $1, $3, $5}' "${manifest}"
		exit 0
	fi

	while (( $# > 0 )); do
		case $1 in
			--state) state_dir=${2:?missing value for --state}; shift 2 ;;
			--timeout) timeout_override=${2:?missing value for --timeout}; shift 2 ;;
			-h | --help) usage; exit 0 ;;
			-*) mpudp_it_die "unknown run-case argument: $1"; exit 2 ;;
			*) if [[ -n ${case_name} ]]; then mpudp_it_die "multiple case names"; exit 2; fi; case_name=$1; shift ;;
		esac
	done

	if [[ -z ${state_dir} || -z ${case_name} ]]; then usage >&2; exit 2; fi
	mpudp_it_require_root
	mpudp_it_require_commands bash ip nft tc timeout go awk sed sha256sum stat
	mpudp_it_load_state "${state_dir}"
	if [[ ! -f ${MPUDP_IT_STATE_DIR}/ready ]]; then mpudp_it_die "topology is not ready"; exit 1; fi

	case_row=$(awk -F '\t' -v name="${case_name}" '$1 == name {print; found=1} END {if (!found) exit 1}' "${manifest}") || {
		mpudp_it_die "unknown integration case: ${case_name}"
		exit 2
	}
	IFS=$'\t' read -r _ runner family case_timeout requires_runtime <<<"${case_row}"
	if [[ ${requires_runtime} == true ]]; then
		mpudp_it_log "SKIP: ${case_name} requires the runnable Peer from issue #7"
		exit 77
	fi
	if [[ -n ${timeout_override} ]]; then case_timeout=${timeout_override}; fi
	if [[ ! ${case_timeout} =~ ^[1-9][0-9]*$ ]] || (( case_timeout > 120 )); then
		mpudp_it_die "case timeout must be 1..120 seconds"
		exit 2
	fi
	if [[ ${runner} == raw-nat-smoke || ${runner} == peer-* ]]; then mpudp_it_require_commands tcpdump grep; fi
	if [[ ${runner} == path-controls ]]; then mpudp_it_require_commands ping; fi
	if [[ ${runner} == peer-smoke || ${runner} == peer-nat-rebinding || ${runner} == direct-single-carrier ]]; then
		mpudp_it_require_commands ss diff
	fi
	exec timeout --signal=TERM --kill-after=10s "${case_timeout}s" \
		bash -c 'source "$1"; trap cleanup_case_worker EXIT; trap "exit 129" HUP; trap "exit 130" INT; trap "exit 143" TERM; run_case_worker "$2" "$3" "$4" "$5" "$6"' \
		"${SCRIPT_DIR}/run-case-worker" "${0}" "${state_dir}" "${case_name}" "${case_timeout}" "${runner}" "${family}"
fi

